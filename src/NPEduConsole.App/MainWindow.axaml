<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App" xmlns:core="using:NPEduConsole.Core" x:Class="NPEduConsole.App.MainWindow"
        Title="NPEduConsole · 学校管理控制台" Width="1160" Height="780" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Border.single-screen Button.class-screen-entry, Border.single-screen TextBlock.class-screen-name, TextBlock.screen-devices-heading">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.single-screen TextBlock.screen-devices-heading">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TextBlock.school-server-warning">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.shell-nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="6,7" />
    </Style>
    <Style Selector="Button.shell-nav:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.shell-nav Border.shell-indicator">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Button.shell-nav.current Border.shell-indicator">
      <Setter Property="Background" Value="{DynamicResource FocusBrush}" />
    </Style>
    <Style Selector="Button.shell-nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.shell-nav.current /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Button.shell-nav TextBlock.shell-label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.nav-content">
      <Setter Property="ColumnSpacing" Value="10" />
    </Style>
    <Style Selector="Grid.compact Grid.nav-content">
      <Setter Property="ColumnSpacing" Value="0" />
    </Style>
    <Style Selector="Button.shell-nav.current TextBlock.shell-label">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Grid.compact :is(Control).shell-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.compact Button.shell-nav">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,6" />
    </Style>
  </Window.Styles>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid x:Name="LoginShell" RowDefinitions="57,*">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="0,0,0,1" Padding="24,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="/Assets/Branding/npeduconsole-64.png" Width="30" Height="30" />
            <TextBlock Text="NPEduConsole" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="OpenServerStatusButton" Grid.Column="1" Background="Transparent" VerticalAlignment="Center"
                  Content="运维诊断" Click="OpenServerStatusClicked" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="LoginView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="LoginColumns" ColumnDefinitions="0.95*,1.05*" MaxWidth="955" Margin="28,27" VerticalAlignment="Center">
          <Border x:Name="LoginBrand" CornerRadius="17,0,0,17" ClipToBounds="True" Background="{DynamicResource OverviewBannerBrush}">
            <Grid>
              <Viewbox Width="238" Height="152" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity=".20" IsHitTestVisible="False">
                <Canvas Width="238" Height="152" ClipToBounds="True">
                  <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                        Data="M-4,147 C65,153 147,141 173,87 C192,49 196,24 248,1 M7,161 C94,163 156,150 184,92 C206,47 214,32 248,17 M46,166 C110,168 170,154 197,98 C214,62 228,45 251,34" />
                </Canvas>
              </Viewbox>
              <StackPanel VerticalAlignment="Center" Margin="36,30" Spacing="14">
                <Image Source="/Assets/Branding/npeduconsole-256.png" Width="168" Height="168" HorizontalAlignment="Left" />
                <TextBlock Text="学校管理控制台" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="学校总览、班级与教务、教室设备" Classes="muted" FontSize="15" />
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="LoginCard" Grid.Column="1" Classes="card" CornerRadius="0,17,17,0" Padding="36,28">
          <StackPanel MaxWidth="440" Spacing="16" VerticalAlignment="Center">
            <StackPanel Spacing="7" Margin="0,0,0,6">
              <TextBlock Text="管理员登录" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="使用学校分配的管理账号。" Classes="muted" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="服务地址" Classes="label" />
              <TextBox x:Name="ServerAddress" PlaceholderText="https://school.example.edu" AutomationProperties.Name="服务地址" />
            </StackPanel>
            <Grid ColumnDefinitions="*,16,*">
              <StackPanel Spacing="6">
                <TextBlock Text="学校代码" Classes="label" />
                <TextBox x:Name="SchoolCode" AutomationProperties.Name="学校代码" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="短账号" Classes="label" />
                <TextBox x:Name="Username" AutomationProperties.Name="短账号" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock Text="密码" Classes="label" />
              <TextBox x:Name="Password" PasswordChar="●" AutomationProperties.Name="密码" />
            </StackPanel>
            <Border x:Name="LoginFeedback" IsVisible="False" Background="{DynamicResource ErrorTintBrush}" CornerRadius="8" Padding="12,9">
              <TextBlock x:Name="LoginMessage" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <ProgressBar x:Name="LoginProgress" IsVisible="False" IsIndeterminate="True" Height="4" />
            <Button x:Name="LoginButton" Classes="action accent" Content="登录" Click="LoginClicked"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    </Grid>
    <Grid x:Name="Workspace" ColumnDefinitions="184,*" IsVisible="False" SizeChanged="ShellSizeChanged">
      <Border Background="{DynamicResource SidebarBrush}" Padding="10,18,10,13">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="24">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="7,0,0,0" VerticalAlignment="Center">
            <Image Source="/Assets/Branding/npeduconsole-64.png" Width="29" Height="29" />
            <TextBlock Classes="shell-label" Text="NPEduConsole" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="6">
          <Button x:Name="OpenSchoolOverviewButton" Classes="shell-nav" Click="SchoolOverviewClicked" IsEnabled="False"
                  AutomationProperties.Name="学校总览" ToolTip.Tip="学校总览">
            <Grid Classes="nav-content" ColumnDefinitions="Auto,Auto">
              <Grid Width="29" Height="24">
                <Border Classes="shell-indicator" HorizontalAlignment="Left" Margin="-4,0,0,0" />
                <Path Classes="shell-glyph" Data="{StaticResource OverviewGlyph}" />
              </Grid>
              <TextBlock Grid.Column="1" Classes="shell-label" Text="学校总览" />
            </Grid>
          </Button>
          <Button x:Name="OpenClassWorkspaceButton" Classes="shell-nav" Click="OpenClassWorkspaceClicked" IsEnabled="False"
                  AutomationProperties.Name="班级与教务" ToolTip.Tip="班级与教务">
            <Grid Classes="nav-content" ColumnDefinitions="Auto,Auto">
              <Grid Width="29" Height="24">
                <Border Classes="shell-indicator" HorizontalAlignment="Left" Margin="-4,0,0,0" />
                <Path Classes="shell-glyph" Data="{StaticResource TeachingGlyph}" />
              </Grid>
              <TextBlock Grid.Column="1" Classes="shell-label" Text="班级与教务" />
            </Grid>
          </Button>
          <Button x:Name="OpenDeviceDirectoryButton" Classes="shell-nav" Click="OpenDeviceDirectoryClicked" IsEnabled="False"
                  AutomationProperties.Name="教室设备" ToolTip.Tip="教室设备">
            <Grid Classes="nav-content" ColumnDefinitions="Auto,Auto">
              <Grid Width="29" Height="24">
                <Border Classes="shell-indicator" HorizontalAlignment="Left" Margin="-4,0,0,0" />
                <Path Classes="shell-glyph" Data="{StaticResource ScreenGlyph}" />
              </Grid>
              <TextBlock Grid.Column="1" Classes="shell-label" Text="教室设备" />
            </Grid>
          </Button>
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="5">
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="7,0,7,5" />
          <Button x:Name="OpenSchoolAuditButton" Classes="shell-nav" Click="SchoolAuditClicked" IsEnabled="False"
                  AutomationProperties.Name="审计记录" ToolTip.Tip="审计记录">
            <Grid Classes="nav-content" ColumnDefinitions="Auto,Auto">
              <Grid Width="29" Height="24">
                <Border Classes="shell-indicator" HorizontalAlignment="Left" Margin="-4,0,0,0" />
                <Path Classes="shell-glyph" Data="{StaticResource HistoryGlyph}" />
              </Grid>
              <TextBlock Grid.Column="1" Classes="shell-label" Text="审计记录" />
            </Grid>
          </Button>
          <Button x:Name="OpenSchoolServerStatusButton" Classes="shell-nav" Click="OpenSchoolServerStatusClicked" IsEnabled="False"
                  AutomationProperties.Name="服务器状态" ToolTip.Tip="服务器状态">
            <Grid Classes="nav-content" ColumnDefinitions="Auto,Auto">
              <Grid Width="29" Height="24">
                <Border Classes="shell-indicator" HorizontalAlignment="Left" Margin="-4,0,0,0" />
                <Path Classes="shell-glyph" Data="{StaticResource ServerGlyph}" />
              </Grid>
              <StackPanel Grid.Column="1" Classes="shell-label" Spacing="2">
                <TextBlock Text="服务器状态" />
                <TextBlock x:Name="SchoolServerStatusSummary" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="119"
                           FontSize="10" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Grid>
          </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="60,*" MinWidth="0">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="19,0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="13">
            <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="11" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
              <ComboBox x:Name="SchoolPicker" HorizontalAlignment="Stretch" MinWidth="147" MaxWidth="264"
                        PlaceholderText="选择已授权学校" AutomationProperties.Name="获授权学校" SelectionChanged="SchoolChanged" />
              <TextBlock x:Name="ShellTermName" Grid.Column="1" Classes="muted" FontSize="12" MaxLines="1"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <local:ShellObjectPicker x:Name="ObjectPicker" Grid.Column="1" VerticalAlignment="Center" />
            <StackPanel x:Name="AccountBar" Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" IsVisible="False">
              <TextBlock x:Name="AccountName" Classes="muted" MaxWidth="84" MaxLines="1"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         VerticalAlignment="Center" />
              <Button Classes="action" MinHeight="36" Content="退出登录" Click="LogoutClicked" AutomationProperties.Name="退出登录" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Border x:Name="SchoolSelectionNotice" IsVisible="False" Classes="card" Padding="25" Margin="27,23"
                  VerticalAlignment="Top" MaxWidth="600" HorizontalAlignment="Left">
            <StackPanel Spacing="7">
              <TextBlock Text="学校总览" FontSize="27" FontWeight="SemiBold" />
              <TextBlock x:Name="SchoolSelectionMessage" Text="请在顶部选择有权管理的学校。" Classes="muted" />
            </StackPanel>
          </Border>
          <Grid x:Name="ClassWorkspaceLayout" ColumnDefinitions="230,*" IsVisible="False">
            <Border x:Name="ClassDirectoryPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,1,0" Padding="12,16">
              <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="9">
                <Grid x:Name="ClassPickerHeading" ColumnDefinitions="*,Auto" ColumnSpacing="3">
                  <TextBlock Text="班级目录" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button x:Name="OpenClassCreationButton" Grid.Column="1" Classes="action" Content="新建行政班"
                          MinHeight="32" Padding="7,4" FontSize="12"
                          Click="OpenClassCreationClicked" IsEnabled="False" />
                </Grid>
                <TextBox x:Name="ClassSearch" Grid.Row="1" PlaceholderText="班名、年级或代码" MinHeight="36"
                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                         AutomationProperties.Name="筛选班级目录">
                  <TextBox.InnerRightContent>
                    <Button x:Name="ClearClassSearch" Content="×" Background="Transparent" BorderThickness="0"
                            Padding="6,1" VerticalAlignment="Center" IsVisible="False"
                            AutomationProperties.Name="清除班级筛选" ToolTip.Tip="清除筛选 (Esc)" Click="ClearClassSearchClicked" />
                  </TextBox.InnerRightContent>
                </TextBox>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                  <TextBlock x:Name="ClassDirectoryCount" VerticalAlignment="Center" Classes="muted" FontSize="12" />
                  <CheckBox x:Name="InactiveClassesFilter" Grid.Column="1" Content="仅已停用" MinHeight="28" FontSize="12"
                            IsEnabled="False" IsCheckedChanged="ClassActivityFilterChanged" />
                </Grid>
                <Grid x:Name="ClassPickerPanel" Grid.Row="3">
                  <ListBox x:Name="ClassPicker" Classes="object-list" Background="Transparent" BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ClassChanged" AutomationProperties.Name="班级">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:Classroom">
                          <Grid ColumnDefinitions="3,*" ColumnSpacing="9">
                            <Border Classes="class-selection" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="{Binding Name}" Classes="label" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                              <TextBlock FontSize="11" Classes="muted" MaxLines="1" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding GradeName}" /><Run Text="  " /><Run Text="{Binding Code}" />
                              </TextBlock>
                            </StackPanel>
                          </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="ClassListMessage" Classes="muted" IsHitTestVisible="False" Text="请先选择学校。" Margin="3,8,3,0" />
                </Grid>
              </Grid>
            </Border>
      <Grid x:Name="ClassManagementWorkspace" Grid.Column="1" RowDefinitions="Auto,Auto,*">
        <Border x:Name="ClassHeader" BorderBrush="{DynamicResource LineBrush}" Padding="22,13">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="9">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border x:Name="ClassEmblem" Classes="class-emblem" Width="45" Height="45" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
              <Path Classes="shell-glyph" Data="{StaticResource ClassGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" HorizontalAlignment="Left">
                <TextBlock x:Name="ClassContext" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="OpenGradeResponsibilityButton" Grid.Column="1" Classes="action" Padding="7,3" MinHeight="28"
                        Content="年级组长" Click="OpenGradeResponsibilityClicked" IsVisible="False" />
              </Grid>
              <TextBlock x:Name="ClassWorkspaceTitle" Text="班级与教务" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
          <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="ReturnToDeviceDirectoryButton" Classes="action" Content="返回设备目录" Click="OpenDeviceDirectoryClicked" IsVisible="False" />
            <Button x:Name="ReturnToSchoolOverviewButton" Classes="action" Content="返回总览" Click="SchoolOverviewClicked" IsVisible="False" />
            <Button x:Name="OpenScreenClassButton" Classes="action" Content="查看所属班级" Click="OpenScreenClassClicked" IsVisible="False" />
            <Button x:Name="OpenClassMaintenanceButton" Classes="action" Content="维护班级" Click="OpenClassMaintenanceClicked" IsVisible="False" />
            <Button x:Name="OpenSchoolStudyButton" Classes="action" Content="学校自习" Click="SchoolStudyClicked" IsVisible="False" />
            <Button x:Name="OpenClassStudyButton" Classes="action" Content="本班学校自习" Click="ClassStudyClicked" IsVisible="False" />
            <Button x:Name="OpenTermPreparationButton" Classes="action" Content="学期管理" Click="OpenTermPreparationClicked" IsVisible="False" />
            <Button x:Name="OpenOrganizationImportButton" Classes="action" Content="开学组织导入" Click="OpenOrganizationImportClicked" IsVisible="False" />
            <Button x:Name="OpenGradeTeachingPlanButton" Classes="action" Content="年级教学安排" Click="OpenGradeTeachingPlanClicked" IsVisible="False" />
            <Button x:Name="OpenCourseGroupsButton" Classes="action" Content="走班教学班" Click="OpenCourseGroupsClicked" IsVisible="False" />
            <Button x:Name="OpenTeacherAccountsButton" Classes="action" Content="教师账号" Click="OpenTeacherAccountsClicked" IsVisible="False" />
            <Button x:Name="OpenClassScreenDirectoryButton" Classes="action" Content="管理班级大屏" Click="OpenClassScreenDirectoryClicked" IsVisible="False" />
            <Button x:Name="OpenSchoolSubjectsButton" Classes="action" Content="学科目录" Click="OpenSchoolSubjectsClicked" IsVisible="False" />
            <Button x:Name="RefreshButton" Classes="action" Content="刷新" Click="RefreshClicked" IsEnabled="False" />
          </WrapPanel>
        </Grid>
        </Border>
        <Border x:Name="ClassCreationNotice" Grid.Row="1" Classes="card" Margin="29,0,29,12" Padding="14,10" IsVisible="False">
          <TextBlock x:Name="ClassCreationNoticeText" Classes="muted" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Border x:Name="ClassMaintenanceNotice" Grid.Row="1" Classes="card" Margin="29,0,29,12" Padding="14,10" IsVisible="False">
          <TextBlock x:Name="ClassMaintenanceNoticeText" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <ScrollViewer x:Name="ClassWorkspaceScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,15,20,24" Spacing="16">
            <Border x:Name="ClassTeachingActions" Classes="card" Padding="4" IsVisible="False">
              <Grid ColumnDefinitions="*,1,*,1,*,1,*">
                <Button x:Name="OpenClassRosterButton" Classes="class-task" Click="OpenClassRosterClicked" IsEnabled="False" AutomationProperties.Name="学生名单">
                  <StackPanel Orientation="Horizontal" Spacing="7"><Path Classes="shell-glyph" Data="{StaticResource RosterGlyph}"/><TextBlock Text="学生名单" Classes="label" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="0,10" />
                <Button Grid.Column="2" x:Name="OpenSubjectSetupButton" Classes="class-task" Click="OpenSubjectSetupClicked" AutomationProperties.Name="配置授课科目">
                  <StackPanel Orientation="Horizontal" Spacing="7"><Path Classes="shell-glyph" Data="{StaticResource TeachingGlyph}"/><TextBlock Text="配置授课科目" Classes="label" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Border Grid.Column="3" Background="{DynamicResource LineBrush}" Margin="0,10" />
                <Button Grid.Column="4" x:Name="OpenTeachingButton" Classes="class-task" Click="OpenTeachingClicked" AutomationProperties.Name="任课分配">
                  <StackPanel Orientation="Horizontal" Spacing="7"><Path Classes="shell-glyph" Data="{StaticResource TeacherGlyph}"/><TextBlock Text="任课分配" Classes="label" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Border Grid.Column="5" Background="{DynamicResource LineBrush}" Margin="0,10" />
                <Button Grid.Column="6" x:Name="OpenClassResponsibilityButton" Classes="class-task" Click="OpenClassResponsibilityClicked" AutomationProperties.Name="班主任">
                  <StackPanel Orientation="Horizontal" Spacing="7"><Path Classes="shell-glyph" Data="{StaticResource TeacherGlyph}"/><TextBlock Text="班主任" Classes="label" VerticalAlignment="Center"/></StackPanel>
                </Button>
              </Grid>
            </Border>
            <StackPanel x:Name="ClassDeviceWorkspace" Spacing="16">
            <ProgressBar x:Name="WorkspaceProgress" IsVisible="False" IsIndeterminate="True" Height="4" />
            <Border x:Name="WorkspaceNotice" Classes="card" Padding="17,13">
              <TextBlock x:Name="WorkspaceMessage" Classes="muted" Text="请选择学校和班级。" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border x:Name="FirstScreenCard" Classes="card" Padding="17,13" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                  <TextBlock x:Name="FirstScreenHeading" Text="教室大屏" Classes="label" FontSize="17" />
                  <TextBlock x:Name="FirstScreenFeedback" Classes="muted" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button x:Name="PrepareFirstScreenButton" Grid.Column="1" Classes="action accent" Content="准备教室大屏"
                        VerticalAlignment="Center" Click="PrepareFirstScreenClicked" />
                <Button x:Name="RefreshFirstScreenButton" Grid.Column="1" Classes="action" Content="刷新大屏列表"
                        VerticalAlignment="Center" Click="RefreshFirstScreenClicked" IsVisible="False" />
              </Grid>
            </Border>
            <TextBlock x:Name="ScreensHeading" Text="绑定大屏和设备" FontSize="18" FontWeight="SemiBold" IsVisible="False" />
            <Border x:Name="ScreenEvidenceCard" IsVisible="False" Classes="card" Padding="19,15"
                    Focusable="True" AutomationProperties.Name="大屏接入记录">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="13" ColumnSpacing="17">
                <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <TextBlock Text="接入记录" Classes="label" FontSize="18" />
                  <TextBlock Grid.Column="1" x:Name="ScreenEvidenceTime" Classes="muted" FontSize="12"
                             VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="6">
                  <TextBlock Text="NPEduTools 接入" Classes="muted" FontSize="13" />
                  <ContentControl x:Name="ScreenNativeEvidence" ContentTemplate="{StaticResource ScreenEvidenceTemplate}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <TextBlock Text="网页值守" Classes="muted" FontSize="13" />
                  <ContentControl x:Name="ScreenBrowserEvidence" ContentTemplate="{StaticResource ScreenEvidenceTemplate}" />
                </StackPanel>
                <Button Grid.Row="2" Grid.ColumnSpan="2" x:Name="OpenScreenDutyButton" Classes="action" Content="管理网页账号与值守"
                        Click="OpenScreenDutyClicked" />
              </Grid>
            </Border>
            <StackPanel x:Name="ScreenCards" Spacing="12" />
            <local:ScreenReplacementView x:Name="ScreenReplacementWorkspace" IsVisible="False" />
            <Border x:Name="ClassAdmissionCard" Classes="card" Padding="20" IsVisible="False">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="大屏口令接入" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="AdmissionScope" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="CloseAdmissionButton" Grid.Column="1" Classes="action" Content="关闭" Click="CloseAdmissionClicked" VerticalAlignment="Top" />
                </Grid>
                <TextBlock x:Name="AdmissionStatus" Classes="label" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="AdmissionMessage" Classes="muted" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="AdmissionAuthorizationNote" Classes="muted" IsVisible="False" TextWrapping="Wrap"
                           Text="开放后，教室端可用班级管理口令连接。已绑定这台大屏的网页也可生成一次性配对码。" />
                <StackPanel x:Name="AdmissionSecretFields" IsVisible="False" Spacing="8" MaxWidth="380" HorizontalAlignment="Left">
                  <TextBlock Text="此口令供本班大屏共用，可提前设置，供教室现场接入。" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="班级管理口令（8 至 128 位）" Classes="label" />
                  <TextBox x:Name="AdmissionSecret" PasswordChar="●" MaxLength="128" IsUndoEnabled="False"
                           AutomationProperties.Name="班级管理口令" />
                  <TextBlock Text="再次输入口令" Classes="label" />
                  <TextBox x:Name="AdmissionSecretConfirmation" PasswordChar="●" MaxLength="128" IsUndoEnabled="False"
                           AutomationProperties.Name="再次输入班级管理口令" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="EnableAdmissionButton" Classes="action accent" Content="开放此大屏的口令接入"
                          Click="EnableAdmissionClicked" IsVisible="False" />
                  <Button x:Name="RefreshAdmissionButton" Classes="action" Content="刷新接入状态" Click="RefreshAdmissionClicked" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border x:Name="EquipmentCard" Classes="card" Padding="20" IsVisible="False">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="5">
                    <TextBlock x:Name="EquipmentDevice" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="EquipmentStatus" Classes="muted" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <Button x:Name="OpenSoftwareMaintenanceButton" Grid.Column="1" Classes="action"
                          VerticalAlignment="Top" Content="软件维护" Click="OpenSoftwareMaintenanceClicked" />
                </Grid>
                <Grid x:Name="EquipmentDetails" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="22" RowSpacing="14">
                  <StackPanel Spacing="4"><TextBlock Text="学校锁定策略" Classes="muted" /><TextBlock x:Name="SchoolPolicy" Classes="label" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="学校指定麦克风" Classes="muted" /><TextBlock x:Name="MicrophoneName" Classes="label" /></StackPanel>
                  <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="已发布版本" Classes="muted" /><TextBlock x:Name="PublishedVersion" Classes="label" /></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="设备已应用版本" Classes="muted" /><TextBlock x:Name="AppliedVersion" Classes="label" /></StackPanel>
                  <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="设备编辑状态" Classes="muted" /><TextBlock x:Name="EquipmentEditingStatus" Classes="label" /></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="设备策略回执时间" Classes="muted" /><TextBlock x:Name="EquipmentReceipt" Classes="label" /></StackPanel>
                  <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4"><TextBlock Text="设备上报的实际选用麦克风" Classes="muted" /><TextBlock x:Name="ReportedMicrophone" Classes="label" /></StackPanel>
                  <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock Text="现场换麦授权" Classes="muted" />
                    <TextBlock x:Name="LocalAuthorizationStatus" Classes="label" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="MicrophoneActions" Spacing="10" IsVisible="False">
                  <TextBlock x:Name="MicrophoneFeedback" Classes="muted" AutomationProperties.LiveSetting="Polite" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <Button x:Name="EditMicrophoneButton" Classes="action" Content="更换指定麦克风"
                            Click="EditMicrophoneClicked" IsVisible="False" />
                    <Button x:Name="EditLocalAuthorizationButton" Classes="action" Content="预授权现场换麦"
                            Click="EditLocalAuthorizationClicked" IsVisible="False" />
                    <Button x:Name="RefreshEquipmentButton" Classes="action" Content="刷新设备状态"
                            Click="RefreshEquipmentClicked" />
                  </WrapPanel>
                </StackPanel>
                <Border x:Name="MicrophoneEditor" Padding="16" CornerRadius="10" IsVisible="False"
                        Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                  <StackPanel Spacing="10">
                    <TextBlock Text="更换指定麦克风" FontSize="16" Classes="label" />
                    <TextBlock x:Name="MicrophoneScope" Classes="muted" />
                    <ComboBox x:Name="MicrophonePicker" HorizontalAlignment="Stretch"
                              PlaceholderText="选择设备上报的麦克风" AutomationProperties.Name="新指定麦克风"
                              SelectionChanged="MicrophoneSelectionChanged" />
                    <TextBlock x:Name="MicrophoneComparison" Classes="label" />
                    <TextBlock Text="如果实际切换了输入，可能需要在现场重新校准。" Classes="muted" />
                    <TextBlock x:Name="MicrophoneUnlockWarning"
                               Text="学校策略要求锁定。设备上次上报为临时解锁，新策略生效后将结束临时解锁。"
                               TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                    <TextBlock x:Name="MicrophoneAuthorizationWarning" Classes="muted"
                               Text="终端收到新策略后会清除现场的旧选择，学校保留现场换麦授权。" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                      <Button x:Name="SaveMicrophoneButton" Classes="action accent" Content="确认并保存"
                              Click="SaveMicrophoneClicked" IsEnabled="False" />
                      <Button x:Name="CancelMicrophoneButton" Classes="action" Content="取消" Click="CancelMicrophoneClicked" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="LocalAuthorizationEditor" Padding="16" CornerRadius="10" IsVisible="False"
                        Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                  <StackPanel Spacing="10">
                    <TextBlock x:Name="LocalAuthorizationHeading" FontSize="16" Classes="label" />
                    <TextBlock x:Name="LocalAuthorizationScope" Classes="muted" />
                    <TextBlock x:Name="LocalAuthorizationDetails" Classes="muted" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                      <Button x:Name="SaveLocalAuthorizationButton" Classes="action accent" Content="确认授权"
                              Click="SaveLocalAuthorizationClicked" IsEnabled="False" />
                      <Button x:Name="CancelLocalAuthorizationButton" Classes="action" Content="取消"
                              Click="CancelLocalAuthorizationClicked" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border x:Name="SoftwareMaintenanceCard" Classes="card" Padding="20" IsVisible="False">
              <StackPanel Spacing="13">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="5">
                    <TextBlock Text="NPEduTools 软件维护" FontSize="18" Classes="label" />
                    <TextBlock x:Name="SoftwareMaintenanceScope" Classes="muted" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="action" Content="关闭" VerticalAlignment="Top" Click="CloseSoftwareMaintenanceClicked" />
                </Grid>
                <TextBlock x:Name="SoftwareMaintenanceStatus" Classes="label" AutomationProperties.LiveSetting="Polite" />
                <Grid x:Name="SoftwareVersions" ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="False">
                  <StackPanel Spacing="4">
                    <TextBlock Text="最近上报的运行版本" Classes="muted" />
                    <TextBlock x:Name="SoftwareObservedVersion" Classes="label" />
                    <TextBlock x:Name="SoftwareObservationTime" Classes="muted" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="任务目标版本" Classes="muted" />
                    <TextBlock x:Name="SoftwareTargetVersion" Classes="label" />
                    <TextBlock x:Name="SoftwarePlanUpdatedAt" Classes="muted" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="SoftwareRollbackReceipt" Classes="label" IsVisible="False" />
                <TextBlock x:Name="SoftwareMaintenanceDetails" Classes="muted" />
                <StackPanel x:Name="SoftwareApprovalForm" Spacing="7" IsVisible="False">
                  <TextBlock Text="学校更新目录" Classes="muted" />
                  <ComboBox x:Name="SoftwareReleasePicker" HorizontalAlignment="Stretch"
                            PlaceholderText="选择要批准的版本" AutomationProperties.Name="选择要批准的版本"
                            SelectionChanged="SoftwareReleaseChanged" />
                </StackPanel>
                <TextBlock x:Name="SoftwareMaintenanceFeedback" Classes="muted" AutomationProperties.LiveSetting="Polite" IsVisible="False" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="InviteSoftwareButton" Content="邀请设备纳管" Classes="action accent" Click="InviteSoftwareClicked" IsVisible="False" />
                  <Button x:Name="WithdrawInvitationButton" Content="撤回邀请" Classes="action" Click="WithdrawInvitationClicked" IsVisible="False" />
                  <Button x:Name="ApproveSoftwareButton" Content="批准此版本" Classes="action accent" Click="ApproveSoftwareClicked" IsVisible="False" />
                  <Button x:Name="CancelSoftwareButton" Content="取消更新任务" Classes="action" Click="CancelSoftwareClicked" IsVisible="False" />
                  <Button x:Name="RefreshSoftwareButton" Content="刷新维护状态" Classes="action" Click="RefreshSoftwareClicked" />
                </WrapPanel>
              </StackPanel>
            </Border>
            </StackPanel>
            <local:ClassStudyView x:Name="StudyWorkspace" IsVisible="False" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
          </Grid>
          <local:SchoolAuditView x:Name="SchoolAuditWorkspace" IsVisible="False" />
          <local:SchoolOverviewView x:Name="SchoolOverviewWorkspace" IsVisible="False" />
          <local:SchoolDeviceDirectoryView x:Name="DeviceDirectory" IsVisible="False" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
