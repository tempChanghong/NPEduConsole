<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Drawn on a shared 24-unit grid. Open paths retain their counters at small sizes. -->
    <StreamGeometry x:Key="OverviewGlyph">M4 3.5 H9 Q10.5 3.5 10.5 5 V12 Q10.5 13.5 9 13.5 H4 Q2.5 13.5 2.5 12 V5 Q2.5 3.5 4 3.5 Z M15 3.5 H20 Q21.5 3.5 21.5 5 V8 Q21.5 9.5 20 9.5 H15 Q13.5 9.5 13.5 8 V5 Q13.5 3.5 15 3.5 Z M4 17 H9 Q10.5 17 10.5 18.5 V19.5 Q10.5 21 9 21 H4 Q2.5 21 2.5 19.5 V18.5 Q2.5 17 4 17 Z M15 13 H20 Q21.5 13 21.5 14.5 V19.5 Q21.5 21 20 21 H15 Q13.5 21 13.5 19.5 V14.5 Q13.5 13 15 13 Z</StreamGeometry>
    <StreamGeometry x:Key="TeachingGlyph">M12 6.4 C9.4 4.4 6.4 3.9 3.2 4.4 Q2.5 4.5 2.5 5.3 V17.7 Q2.5 18.5 3.4 18.4 C6.7 17.9 9.5 18.4 12 20.3 C14.5 18.4 17.3 17.9 20.6 18.4 Q21.5 18.5 21.5 17.7 V5.3 Q21.5 4.5 20.8 4.4 C17.6 3.9 14.6 4.4 12 6.4 Z M12 6.4 V20 M6 8.7 Q7.6 8.6 9 9.2 M15 9.2 Q16.5 8.6 18 8.7</StreamGeometry>
    <StreamGeometry x:Key="ScreenGlyph">M5.1 4.6 H18.9 Q21 4.6 21 6.7 V15.2 Q21 17.3 18.9 17.3 H5.1 Q3 17.3 3 15.2 V6.7 Q3 4.6 5.1 4.6 Z M12 17.4 V20.5 M8 20.6 H16</StreamGeometry>
    <StreamGeometry x:Key="HistoryGlyph">M3 5.4 V10 H7.7 M3.5 9.6 A8.6 8.6 0 1 1 4.2 16.5 M12 7.7 V12.1 L15.3 14.2</StreamGeometry>
    <StreamGeometry x:Key="ServerGlyph">M5.2 3.8 H18.8 Q21 3.8 21 6 V8.2 Q21 10.4 18.8 10.4 H5.2 Q3 10.4 3 8.2 V6 Q3 3.8 5.2 3.8 Z M5.2 13.5 H18.8 Q21 13.5 21 15.7 V17.9 Q21 20.1 18.8 20.1 H5.2 Q3 20.1 3 17.9 V15.7 Q3 13.5 5.2 13.5 Z M6.2 7.1 H7.2 M6.2 16.8 H7.2</StreamGeometry>
    <StreamGeometry x:Key="ForwardGlyph">M5 12 H19 M13 6 L19 12 L13 18</StreamGeometry>
  </Styles.Resources>
  <Style Selector="Path.shell-glyph">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.65" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Button.shell-nav.current Path.shell-glyph">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="1.9" />
  </Style>
</Styles>
