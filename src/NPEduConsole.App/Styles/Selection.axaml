<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Keep a stable outline when a table row gains keyboard focus or selection. -->
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
  </Style>

  <!-- Independent destinations, such as classes or devices, also retain an outline at rest. -->
  <Style Selector="ListBox.object-list > ListBoxItem">
    <Setter Property="Margin" Value="1,2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.object-list > ListBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ListBox.object-list > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox.object-list > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.object-list > ListBoxItem:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
  </Style>
</Styles>
