<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App">
  <Styles.Resources>
    <DataTemplate x:Key="ScreenEvidenceTemplate" x:DataType="local:DeviceEvidence">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
          <Ellipse Classes="evidence-dot" Classes.confirmed="{Binding Confirmed}"
                   Classes.pending="{Binding Pending}" Classes.attention="{Binding Attention}" />
          <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
        </Grid>
        <TextBlock Text="{Binding Record}" IsVisible="{Binding HasRecord}" Classes="muted" FontSize="12"
                   Margin="13,0,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </Styles.Resources>
  <Style Selector="Ellipse.evidence-dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.evidence-dot.confirmed">
    <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Ellipse.evidence-dot.pending">
    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
    <Setter Property="Fill" Value="{DynamicResource WarningTintBrush}" />
  </Style>
  <Style Selector="Ellipse.evidence-dot.attention">
    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>
</Styles>
