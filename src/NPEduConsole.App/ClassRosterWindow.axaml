<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App" x:Class="NPEduConsole.App.ClassRosterWindow"
        Title="学生名单" Width="950" Height="720" MinWidth="790" MinHeight="530" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <DataTemplate x:Key="RosterTextRow">
      <TextBlock Text="{Binding}" TextWrapping="Wrap" />
    </DataTemplate>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.roster-row-action">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="TextBlock.roster-error">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource CanvasBrush}">
    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="23,17">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="5">
          <TextBlock x:Name="RosterScope" Classes="muted" />
          <TextBlock Text="学生名单" FontSize="25" FontWeight="SemiBold" />
        </StackPanel>
        <Button x:Name="ReloadRosterButton" Grid.Column="1" Content="重新载入" Classes="action" Click="ReloadClicked" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="RosterContentHost" Grid.Row="1" Margin="22,14" RowDefinitions="Auto,*" RowSpacing="10">
      <TextBlock x:Name="RosterFeedback" Classes="muted" IsVisible="False" AutomationProperties.LiveSetting="Polite" />

      <Grid x:Name="RosterEditorPane" Grid.Row="1" ColumnDefinitions="*,282" ColumnSpacing="12" IsVisible="False">
        <Border Classes="card" Padding="12">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock x:Name="RosterCount" FontSize="17" Classes="label" VerticalAlignment="Center" />
              <Button x:Name="AddRosterStudent" Grid.Column="1" Content="添加学生" Classes="action" Click="AddClicked" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="30,*,0.8*,148" ColumnSpacing="7" Margin="2,0,6,0">
              <TextBlock Text="序号" Classes="muted" />
              <TextBlock Grid.Column="1" Text="姓名" Classes="muted" />
              <TextBlock Grid.Column="2" Text="学号（可空）" Classes="muted" />
              <TextBlock Grid.Column="3" Text="行操作" Classes="muted" />
            </Grid>
            <Grid Grid.Row="2">
              <ScrollViewer x:Name="RosterRowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RosterRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RosterDraftRow">
                      <Grid ColumnDefinitions="30,*,0.8*,148" ColumnSpacing="7" Margin="2,0,6,8">
                        <TextBlock Text="{Binding Position}" Classes="muted" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="学生姓名" />
                        <TextBox Grid.Column="2" Text="{Binding StudentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="学生学号" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Content="上移" Classes="action roster-row-action" IsEnabled="{Binding CanMoveUp}" Click="MoveUpClicked" />
                          <Button Content="下移" Classes="action roster-row-action" IsEnabled="{Binding CanMoveDown}" Click="MoveDownClicked" />
                          <Button Content="移出" Classes="action roster-row-action" Click="RemoveClicked" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock x:Name="EmptyRosterDraft" Classes="muted" Text="草稿暂无学生。可添加学生，或从右侧批量粘贴。"
                         IsHitTestVisible="False" Margin="2,10,2,0" IsVisible="False" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="13">
          <Grid>
            <Grid x:Name="RosterImportPane" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="9">
              <TextBlock Text="批量粘贴" FontSize="17" Classes="label" />
              <TextBlock Grid.Row="1" Classes="muted" Text="从 Excel 复制学号和姓名两列，不含表头。纯文本每行写姓名，或写学号、空格、姓名。" />
              <ComboBox x:Name="RosterImportMode" Grid.Row="2" HorizontalAlignment="Stretch" AutomationProperties.Name="批量导入方式"
                        SelectionChanged="ImportModeChanged">
                <ComboBoxItem Content="追加或更新" />
                <ComboBoxItem Content="整班替换" />
              </ComboBox>
              <TextBox x:Name="RosterPasteText" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                       PlaceholderText="在此粘贴名单" TextChanged="DraftTextChanged" AutomationProperties.Name="批量粘贴名单" />
              <StackPanel Grid.Row="4" Spacing="7">
                <TextBlock x:Name="RosterImportHint" Classes="muted" />
                <Button x:Name="ApplyRosterImport" Classes="action" Content="应用到草稿" Click="ApplyImportClicked" />
              </StackPanel>
            </Grid>

            <Grid x:Name="RosterComparisonPane" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="9" IsVisible="False">
              <TextBlock Text="当前学校名单" FontSize="17" Classes="label" />
              <TextBlock x:Name="RosterComparisonHint" Grid.Row="1" Classes="muted" />
              <ListBox x:Name="CurrentRosterRows" Grid.Row="2" AutomationProperties.Name="当前学校名单"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource RosterTextRow}" SelectionChanged="CurrentSelectionChanged" />
              <WrapPanel Grid.Row="3" ItemSpacing="5" LineSpacing="5">
                <Button x:Name="RecheckRosterButton" Classes="action roster-row-action" Content="重新核对" Click="RecheckClicked" />
                <Button x:Name="UseCurrentStudentButton" Classes="action roster-row-action" Content="将选中行用到草稿" Click="UseCurrentStudentClicked" />
              </WrapPanel>
              <Button x:Name="AdoptRosterRevisionButton" Grid.Row="4" Classes="action" Content="保留草稿并采用当前版本" Click="AdoptRevisionClicked" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="RosterReviewPane" Grid.Row="1" Classes="card" Padding="14" IsVisible="False">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
          <TextBlock Text="核对本次变更" Classes="label" FontSize="17" />
          <TextBlock x:Name="RosterReviewSummary" Grid.Row="1" Classes="muted" />
          <ListBox x:Name="RosterChangesList" Grid.Row="2" AutomationProperties.Name="待保存的名单变更"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource RosterTextRow}" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,10">
      <Grid>
        <Grid x:Name="RosterMainActions" ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock x:Name="RosterDraftState" VerticalAlignment="Center" Classes="muted" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CopyRosterDraftButton" Content="复制草稿" Classes="action" Click="CopyDraftClicked" />
            <Button x:Name="CancelRosterReview" Content="返回编辑" Classes="action" Click="CancelReviewClicked" IsVisible="False" />
            <Button x:Name="CloseRosterButton" Content="关闭" Classes="action" Click="CloseClicked" />
            <Button x:Name="PreviewRosterButton" Content="预览变更" Classes="action accent" Click="PreviewClicked" />
            <Button x:Name="ConfirmRosterSave" Content="确认保存名单" Classes="action accent" Click="SaveClicked" IsVisible="False" />
          </StackPanel>
        </Grid>
        <Grid x:Name="RosterDiscardActions" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="False">
          <TextBlock x:Name="RosterDiscardWarning" VerticalAlignment="Center" Classes="label" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="KeepRosterEditing" Content="保留草稿" Classes="action" Click="KeepEditingClicked" />
            <Button x:Name="ConfirmRosterDiscard" Content="放弃草稿" Classes="action" Click="DiscardClicked" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
