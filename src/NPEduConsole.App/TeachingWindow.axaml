<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NPEduConsole.App.TeachingWindow" Title="行政班任课"
        Width="820" Height="720" MinWidth="560" MinHeight="490" WindowStartupLocation="CenterOwner">
  <Border Background="{StaticResource CanvasBrush}" Padding="24">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <StackPanel Spacing="5">
      <TextBlock Text="行政班任课" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="TeachingContext" Classes="muted" TextWrapping="Wrap"/>
      <TextBlock x:Name="TeachingFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="0,0,10,0">
        <StackPanel x:Name="TeachingFields" Spacing="12" IsEnabled="False">
          <TextBlock Text="任教学科" FontWeight="SemiBold"/>
          <ComboBox x:Name="TeachingSubjectPicker" SelectionChanged="SubjectChanged" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="任教学科"/>
          <Border Classes="card" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="本班已有任课" FontWeight="SemiBold"/>
              <TextBlock x:Name="TeachingExistingEmpty" Text="本班此科目暂无任课关系。" Classes="muted"/>
              <ComboBox x:Name="TeachingExistingPicker" SelectionChanged="ExistingChanged" IsVisible="False"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="选择已有任课关系"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TeachingAddButton" Classes="action" Content="新增任课" Click="AddClicked"/>
                <Button x:Name="TeachingChangeButton" Classes="action" Content="修改所选" IsEnabled="False" Click="ChangeClicked"/>
                <Button x:Name="TeachingRemoveButton" Classes="action" Content="移除所选" IsEnabled="False" Click="RemoveClicked"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="TeachingOperation" FontSize="17" FontWeight="SemiBold"/>
          <Grid x:Name="TeachingAssignmentFields" ColumnDefinitions="*,175" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="本校教师"/>
              <ComboBox x:Name="TeachingTeacherPicker" SelectionChanged="DraftChanged" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="本校教师"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="任课身份"/>
              <ComboBox x:Name="TeachingPositionPicker" SelectionChanged="DraftChanged" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="任课身份" SelectedIndex="0">
                <ComboBoxItem Content="主讲"/>
                <ComboBoxItem Content="协同"/>
              </ComboBox>
            </StackPanel>
          </Grid>
          <StackPanel x:Name="TeachingPeers" Spacing="5">
            <TextBlock Text="同时分配给同年级的其他班" FontWeight="SemiBold"/>
            <StackPanel x:Name="TeachingClassChoices" Spacing="3"/>
          </StackPanel>
          <TextBlock x:Name="TeachingAccessNote" TextWrapping="Wrap" Classes="muted"/>
        </StackPanel>
        <StackPanel x:Name="TeachingRows" Spacing="6"/>
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
      <Button x:Name="TeachingPreviewButton" Classes="action" Content="预览安排" Click="PreviewClicked" IsEnabled="False"/>
      <Button x:Name="TeachingApplyButton" Classes="accent" Content="确认提交" Click="ApplyClicked" IsEnabled="False"/>
      <Button x:Name="TeachingReadButton" Classes="action" Content="刷新安排" Click="ReadClicked"/>
      <Button Content="返回" Classes="action" Click="CloseClicked"/>
    </WrapPanel>
  </Grid>
  </Border>
</Window>
