<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:NPEduConsole.Core" x:Class="NPEduConsole.App.TeacherAllocationView"
        Focusable="True">
  <UserControl.Styles>
    <Style Selector="ListBox.allocation-review > ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ListBox.allocation-review > ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBox.allocation-review > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.allocation-review > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style Selector="ListBox.allocation-review > ListBoxItem:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="StackPanel.allocation-inline-values">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel.allocation-inline-values">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="TextBlock.allocation-review-state.stale">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
        <TextBlock x:Name="AllocationHeading" Text="批量导入与分配" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="1" x:Name="AllocationStageLabel" Classes="label" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="AllocationScope" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" Margin="14,5,14,3">
      <Grid x:Name="AllocationTargetFields" ColumnDefinitions="1.35*,1*,Auto,Auto" ColumnSpacing="7">
        <ComboBox x:Name="AllocationTerm" HorizontalAlignment="Stretch" PlaceholderText="目标学期"
                  SelectionChanged="TermChanged" AutomationProperties.Name="目标学期"/>
        <ComboBox Grid.Column="1" x:Name="AllocationGrade" HorizontalAlignment="Stretch" PlaceholderText="目标年级"
                  SelectionChanged="GradeChanged" AutomationProperties.Name="目标年级"/>
        <Button Grid.Column="2" x:Name="AllocationJson" Content="打开旧 JSON" Classes="action" Click="OpenJsonClicked"/>
        <Button Grid.Column="3" x:Name="AllocationPaste" Content="从 Excel 粘贴" Classes="action" Click="OpenPasteClicked"/>
      </Grid>
      <TextBlock Grid.Row="1" x:Name="AllocationStatus" Classes="muted" TextWrapping="Wrap" MaxLines="2" IsVisible="False"
                 TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
      <Border Grid.Row="2" x:Name="AllocationTargetNotice" IsVisible="False" Background="{DynamicResource WarningTintBrush}"
              CornerRadius="7" Padding="8,4">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" x:Name="AllocationKeepTable" Content="保留原草稿" Classes="action"
                  Margin="6,0,0,0" IsVisible="False" Click="KeepAllocationTableClicked"/>
          <TextBlock x:Name="AllocationTargetDetails" TextWrapping="Wrap" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
      </Border>
      <WrapPanel Grid.Row="3" x:Name="AllocationPendingActions" ItemSpacing="6" LineSpacing="4" IsVisible="False"/>
    </Grid>
    <Panel Grid.Row="2" Margin="14,5,14,7">
      <Grid x:Name="AllocationEditLayout" ColumnDefinitions="3*,2*" ColumnSpacing="9">
        <Grid x:Name="AllocationTeacherTable" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="5">
          <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="7">
            <TextBox x:Name="AllocationSearchExisting" PlaceholderText="搜索已有教师" TextChanged="SearchExistingChanged"
                     AutomationProperties.Name="搜索已有教师"/>
            <ComboBox Grid.Column="1" x:Name="AllocationExisting" HorizontalAlignment="Stretch" PlaceholderText="从目录加入"
                      SelectionChanged="ExistingChosen" AutomationProperties.Name="已有教师搜索结果"/>
          </Grid>
          <Grid Grid.Row="1" x:Name="AllocationTeacherHeader" ColumnDefinitions="1.3*,1*,1*,Auto" ColumnSpacing="5" Margin="7,0">
            <TextBlock x:Name="AllocationIdentityHeader" Text="短账号" Classes="label"/>
            <TextBlock Grid.Column="1" Text="姓名" Classes="label"/>
            <TextBlock Grid.Column="2" x:Name="AllocationPinHeader" Text="初始 PIN" Classes="label"/>
          </Grid>
          <ListBox Grid.Row="2" x:Name="AllocationTeachers" SelectionChanged="TeacherSelected"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="待导入教师表"/>
          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="7">
            <Button x:Name="AllocationAddTeacher" Content="添加教师行" Classes="action" Click="AddTeacherClicked"/>
            <Button x:Name="AllocationOpenEditor" Content="展开班级访问" Classes="action" Click="OpenEditorClicked" IsVisible="False"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Column="1" x:Name="AllocationAccessEditor" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="5">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="AllocationEditorHeading" Classes="label" TextWrapping="Wrap"/>
            <Button Grid.Column="1" x:Name="AllocationBackToTable" Content="返回教师表" Classes="action" Click="BackToTableClicked" IsVisible="False"/>
          </Grid>
          <CheckBox Grid.Row="1" x:Name="AllocationConfirmName" Content="已核对这是另一位同名教师" IsCheckedChanged="ConfirmNameChanged"/>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AllocationAccessRows" Spacing="6"/>
          </ScrollViewer>
          <Button Grid.Row="3" x:Name="AllocationAddAccess" Content="添加班级或教学班" Classes="action" Click="AddAccessClicked"/>
        </Grid>
      </Grid>
      <Grid x:Name="AllocationReviewLayout" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="5">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <ComboBox x:Name="AllocationFilter" HorizontalAlignment="Stretch" SelectionChanged="FilterChanged" AutomationProperties.Name="筛选差异"/>
          <TextBlock Grid.Column="1" x:Name="AllocationCounts" VerticalAlignment="Center" Classes="muted"/>
          <Button Grid.Column="2" x:Name="AllocationLocate" Content="定位所选行" Classes="action" Click="LocateClicked"/>
        </Grid>
        <Grid Grid.Row="1" x:Name="AllocationReviewHeader" ColumnDefinitions="76,1.4*,1.4*,1.6*,1.6*" ColumnSpacing="6" Margin="7,0,22,0">
          <TextBlock Text="状态" Classes="label"/><TextBlock Grid.Column="1" Text="教师" Classes="label"/>
          <TextBlock Grid.Column="2" Text="教学空间" Classes="label"/>
          <TextBlock Grid.Column="3" x:Name="AllocationCurrentHeader" Text="现在" Classes="label"/>
          <TextBlock Grid.Column="4" x:Name="AllocationAfterHeader" Text="提交后" Classes="label"/>
        </Grid>
        <ListBox Grid.Row="2" x:Name="AllocationDifferences" Classes="allocation-review"
                 Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                 CornerRadius="7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="教师分配差异">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:AllocationDifference">
              <Grid ColumnDefinitions="76,1.4*,1.4*,1.6*,1.6*" ColumnSpacing="6" RowDefinitions="Auto,Auto" Margin="7,4">
                <TextBlock Text="{Binding ActionLabel}" Classes="label allocation-review-state" Classes.stale="{Binding NeedsReview}"/>
                <TextBlock Grid.Column="1" Text="{Binding Teacher}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Text="{Binding Scope}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="3" Text="{Binding BeforeText}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="4" Text="{Binding AfterText}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Message}" IsVisible="{Binding HasMessage}" Classes="muted" TextWrapping="Wrap"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <CheckBox Grid.Row="3" x:Name="AllocationApprove" Content="我已核对本批账号及每项访问变化" IsCheckedChanged="ApprovalChanged"/>
      </Grid>

      <Grid x:Name="AllocationTeacherDirectoryLayout" IsVisible="False" ColumnDefinitions="2*,3*" ColumnSpacing="9">
        <Grid x:Name="AllocationTeacherDirectoryList" RowDefinitions="Auto,*,Auto" RowSpacing="5">
          <TextBox x:Name="AllocationTeacherSearch" PlaceholderText="查找姓名、短账号或邮箱" TextChanged="DirectorySearchChanged"/>
          <ListBox Grid.Row="1" x:Name="AllocationDirectoryTeachers" Classes="object-list" Background="Transparent" BorderThickness="0"
                   SelectionChanged="DirectoryPersonChanged" AutomationProperties.Name="教师或待认领邮箱"/>
          <Button Grid.Row="2" x:Name="AllocationOpenTeacherDetails" IsVisible="False" Classes="action"
                  Content="查看所选教师" Click="OpenTeacherDetailsClicked"/>
        </Grid>
        <Grid Grid.Column="1" x:Name="AllocationTeacherDirectoryDetail" RowDefinitions="Auto,Auto,*" RowSpacing="4">
          <Button x:Name="AllocationBackFromTeacherDetails" IsVisible="False" Classes="action"
                  HorizontalAlignment="Left" Content="返回教师列表" Click="DirectoryListClicked"/>
          <TextBlock Grid.Row="1" x:Name="AllocationTeacherResultHeading" Classes="label" TextWrapping="Wrap"/>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AllocationTeacherDetails" Spacing="5"/>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Grid x:Name="AllocationSpaceDirectoryLayout" IsVisible="False" ColumnDefinitions="2*,3*" ColumnSpacing="9">
        <Grid x:Name="AllocationSpaceDirectoryList" RowDefinitions="Auto,*,Auto" RowSpacing="5">
          <TextBox x:Name="AllocationSpaceSearch" PlaceholderText="查找行政班或走班教学班" TextChanged="DirectorySearchChanged"/>
          <ListBox Grid.Row="1" x:Name="AllocationDirectorySpaces" Classes="object-list" Background="Transparent" BorderThickness="0"
                   SelectionChanged="DirectorySpaceChanged" AutomationProperties.Name="教学空间"/>
          <Button Grid.Row="2" x:Name="AllocationOpenSpaceDetails" IsVisible="False" Classes="action"
                  Content="查看所选教学空间" Click="OpenSpaceDetailsClicked"/>
        </Grid>
        <Grid Grid.Column="1" x:Name="AllocationSpaceDirectoryDetail" RowDefinitions="Auto,Auto,*" RowSpacing="4">
          <Button x:Name="AllocationBackFromSpaceDetails" IsVisible="False" Classes="action"
                  HorizontalAlignment="Left" Content="返回教学空间列表" Click="DirectoryListClicked"/>
          <TextBlock Grid.Row="1" x:Name="AllocationSpaceResultHeading" Classes="label" TextWrapping="Wrap"/>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AllocationSpaceDetails" Spacing="5"/>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid x:Name="AllocationReceiptLayout" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <StackPanel><TextBlock x:Name="AllocationReceiptSummary" Classes="label" TextWrapping="Wrap"/>
          <TextBlock x:Name="AllocationPinHint" Classes="muted" TextWrapping="Wrap" IsVisible="False"/>
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="AllocationReceiptRows" Classes="object-list" Background="Transparent"
                 AutomationProperties.Name="本次分配回执" SelectionChanged="ReceiptRowSelected"/>
        <WrapPanel Grid.Row="2" ItemSpacing="6" LineSpacing="4">
          <Button x:Name="AllocationCopyPin" IsVisible="False" Classes="action" Content="复制本次 PIN" Click="DeliverPinClicked"/>
          <Button x:Name="AllocationSavePin" IsVisible="False" Classes="action" Content="另存本次 PIN" Click="DeliverPinClicked"/>
          <Button x:Name="AllocationReceiptPerson" Classes="action" Content="查看该教师" Click="ReceiptPersonClicked"/>
          <Button x:Name="AllocationReceiptSpace" Classes="action" Content="查看该教学空间" Click="ReceiptSpaceClicked"/>
          <Button x:Name="AllocationReceiptTeaching" Classes="action accent" Content="继续分配任课" Click="ReceiptTeachingClicked"/>
        </WrapPanel>
      </Grid>
    </Panel>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="13,6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
        <Button x:Name="AllocationClose" Classes="action" Content="返回" Click="CloseClicked"/>
        <TextBlock Grid.Column="1" x:Name="AllocationFooter" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <WrapPanel Grid.Column="2" ItemSpacing="6" LineSpacing="4">
          <Button x:Name="AllocationKeepEditing" Classes="action" Content="继续编辑" Click="KeepEditingClicked" IsVisible="False"/>
          <Button x:Name="AllocationDiscard" Classes="action" Content="放弃草稿并返回" Click="DiscardClicked" IsVisible="False"/>
          <Button x:Name="AllocationEdit" Classes="action" Content="返回教师表" Click="EditClicked" IsVisible="False"/>
          <Button x:Name="AllocationBackToReview" Classes="action" Content="返回差异" Click="BackToReviewClicked" IsVisible="False"/>
          <Button x:Name="AllocationBackToReceipt" Classes="action" Content="返回本次回执" Click="BackToReceiptClicked" IsVisible="False"/>
          <Button x:Name="AllocationByTeacher" Classes="action" Content="按教师查" Click="ByTeacherClicked"/>
          <Button x:Name="AllocationBySpace" Classes="action" Content="按班查" Click="BySpaceClicked"/>
          <Button x:Name="AllocationRefresh" Classes="action" Content="刷新当前范围" Click="RefreshClicked"/>
          <Button x:Name="AllocationVerify" Classes="action accent" Content="只读核对原回执" Click="VerifyClicked" IsVisible="False"/>
          <Button x:Name="AllocationPreviewButton" Classes="action accent" Content="预览分配" Click="PreviewClicked"/>
          <Button x:Name="AllocationSave" Classes="action accent" Content="确认保存" Click="SaveClicked" IsVisible="False"/>
          <Button x:Name="AllocationSchoolProfile" Classes="action" Content="教师登录设置" Click="OpenSchoolProfileClicked" IsVisible="False"/>
          <Button x:Name="AllocationLegacyWeb" Classes="action" Content="打开兼容网页入口" Click="OpenLegacyWebClicked" IsVisible="False"/>
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
