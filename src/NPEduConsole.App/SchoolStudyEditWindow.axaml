<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App" x:Class="NPEduConsole.App.SchoolStudyEditWindow"
        Title="编辑学校自习安排" Width="1160" Height="780" MinWidth="670" MinHeight="440" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,9">
      <StackPanel Spacing="3">
        <TextBlock x:Name="StudyEditTitle" FontSize="23" Classes="label"/>
        <TextBlock x:Name="StudyEditScope" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6" Margin="13,8">
      <TextBlock x:Name="StudyEditStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TabControl x:Name="StudyEditTabs" Grid.Row="1">
        <TabItem x:Name="StudyEditFieldsTab" Header="安排与例外">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <StackPanel Spacing="9" Margin="0,0,10,5">
              <WrapPanel ItemSpacing="6" LineSpacing="5">
                <ComboBox x:Name="StudyPolicyMode" Width="180" SelectionChanged="ModeChanged" AutomationProperties.Name="安排来源"/>
                <ComboBox x:Name="StudyScheduleMode" Width="130" SelectionChanged="ScheduleModeChanged" AutomationProperties.Name="日常或考试"/>
              </WrapPanel>
              <TextBlock x:Name="StudyEditModeNote" Classes="muted" TextWrapping="Wrap"/>
              <StackPanel x:Name="StudyMonitorFields" IsVisible="False" Spacing="8">
                <Border Classes="card" Padding="12">
                  <StackPanel Spacing="7">
                    <TextBlock x:Name="StudyMonitorCurrent" Classes="label" TextWrapping="Wrap"/>
                    <ToggleSwitch x:Name="MonitorEnabled" OnContent="启用噪音监测" OffContent="关闭噪音监测" IsCheckedChanged="MonitorToggled"/>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <StackPanel Spacing="3"><TextBlock Text="阈值依据" Classes="muted"/>
                        <ComboBox x:Name="MonitorUnit" Width="175" SelectionChanged="MonitorUnitChanged" AutomationProperties.Name="阈值依据"/>
                      </StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="中线（可空）" Classes="muted"/>
                        <TextBox x:Name="MonitorMedium" Width="112" TextChanged="MonitorTextChanged" AutomationProperties.Name="中线"/>
                      </StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="高线（可空）" Classes="muted"/>
                        <TextBox x:Name="MonitorHigh" Width="112" TextChanged="MonitorTextChanged" AutomationProperties.Name="高线"/>
                      </StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="高线持续秒数" Classes="muted"/>
                        <TextBox x:Name="MonitorHighSeconds" Width="112" TextChanged="MonitorTextChanged" AutomationProperties.Name="高线持续秒数"/>
                      </StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="提醒间隔（秒）" Classes="muted"/>
                        <TextBox x:Name="MonitorReminder" Width="112" TextChanged="MonitorTextChanged" AutomationProperties.Name="提醒间隔"/>
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="dBFS 是麦克风信号电平。估算 dB(A) 需教室在本机作参考校准后才能用于阈值判定。" Classes="muted" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Classes="card" Padding="12">
                  <StackPanel Spacing="7">
                    <TextBlock Text="照片记录" Classes="label"/>
                    <ToggleSwitch x:Name="MonitorPhotos" OnContent="启用拍照" OffContent="关闭拍照" IsCheckedChanged="MonitorToggled"/>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <StackPanel Spacing="3"><TextBlock Text="拍照间隔（秒）" Classes="muted"/>
                        <TextBox x:Name="MonitorPhotoSeconds" Width="120" TextChanged="MonitorTextChanged" AutomationProperties.Name="拍照间隔"/>
                      </StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="保留天数" Classes="muted"/>
                        <TextBox x:Name="MonitorRetention" Width="120" TextChanged="MonitorTextChanged" AutomationProperties.Name="保留天数"/>
                      </StackPanel>
                    </WrapPanel>
                    <CheckBox x:Name="MonitorExtended" Content="学校已批准在线记录保留超过 30 天" IsVisible="False" IsCheckedChanged="MonitorToggled"/>
                    <TextBlock Text="摄像头须在教室现场选择。有效定时自习及符合学校策略的手动自习可触发；准备阶段和单独开启的手动噪音监测不触发。" Classes="muted" TextWrapping="Wrap"/>
                    <TextBlock Text="缩短会提前在线照片与退出记录的到期时间。延长仅影响之后保存的记录。备份副本的保留另由部署决定。" Classes="muted" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="StudyScheduleFields" Spacing="9">
                <Border Classes="card" Padding="10">
                  <StackPanel Spacing="7">
                    <TextBlock Text="生效范围" Classes="label"/>
                    <WrapPanel ItemSpacing="8" LineSpacing="5">
                      <CalendarDatePicker x:Name="StudyFrom" Classes="study-date" Width="155" PlaceholderText="生效日" SelectedDateChanged="DateBoundChanged" AutomationProperties.Name="生效日期"/>
                      <CalendarDatePicker x:Name="StudyTo" Classes="study-date" Width="155" PlaceholderText="截止日（可空）" SelectedDateChanged="DateBoundChanged" AutomationProperties.Name="截止日期"/>
                      <Button Classes="action" Content="清除截止日" Click="ClearEndDate"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Classes="card" Padding="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="每周时段" Classes="label"/>
                    <ListBox x:Name="StudyRules" Classes="object-list" MaxHeight="164" AutomationProperties.Name="现有每周时段" SelectionChanged="RuleSelected"/>
                    <WrapPanel x:Name="StudyRuleDays" ItemSpacing="8" LineSpacing="4"/>
                    <WrapPanel ItemSpacing="6" LineSpacing="4">
                      <TextBox x:Name="StudyRuleStart" Width="100" PlaceholderText="开始 HH:mm" MaxLength="5" AutomationProperties.Name="时段开始"/>
                      <TextBox x:Name="StudyRuleEnd" Width="100" PlaceholderText="结束 HH:mm" MaxLength="5" AutomationProperties.Name="时段结束"/>
                      <Button x:Name="StudyApplyRule" Classes="action" Click="ApplyRule" Content="加入时段"/>
                      <Button x:Name="StudyNewRule" Classes="action" Click="NewRule" Content="新时段"/>
                      <Button x:Name="StudyRemoveRule" Classes="action" Click="RemoveRule" Content="移除所选"/>
                    </WrapPanel>
                    <TextBlock Text="结束早于开始时跨午夜。每场 1 至 180 分钟。" Classes="muted" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Classes="card" Padding="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="指定日期例外" Classes="label"/>
                    <ListBox x:Name="StudyExceptions" Classes="object-list" MaxHeight="148" SelectionChanged="ExceptionSelected" AutomationProperties.Name="现有日期例外"/>
                    <WrapPanel ItemSpacing="6" LineSpacing="4">
                      <CalendarDatePicker x:Name="StudyExceptionDate" Classes="study-date" Width="155" AutomationProperties.Name="例外日期"/>
                      <ComboBox x:Name="StudyExceptionKind" Width="128" SelectionChanged="ExceptionKindChanged" AutomationProperties.Name="例外处理方式"/>
                      <ComboBox x:Name="StudyExceptionWeekday" Width="100" AutomationProperties.Name="补课采用的星期"/>
                      <Button x:Name="StudyApplyException" Classes="action" Click="ApplyException" Content="加入例外"/>
                      <Button x:Name="StudyNewException" Classes="action" Click="NewException" Content="新例外"/>
                      <Button x:Name="StudyRemoveException" Classes="action" Click="RemoveException" Content="移除所选"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="逐班影响">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7">
            <TextBlock x:Name="StudyImpactSummary" Classes="label" TextWrapping="Wrap"/>
            <Border Grid.Row="1" HorizontalAlignment="Left" Width="{Binding #SchoolStudyImpact.Scroll.Viewport.Width}">
              <Border Margin="1,0" Padding="12,0" BorderThickness="1,0" BorderBrush="Transparent">
                <Grid x:Name="StudyImpactHeader" ColumnDefinitions="0.85*,1.4*,1.4*" ColumnSpacing="8">
                  <TextBlock Text="班级" Classes="muted"/><TextBlock Grid.Column="1" Text="当前" Classes="muted"/>
                  <TextBlock Grid.Column="2" Text="保存后" Classes="muted"/>
                </Grid>
              </Border>
            </Border>
            <ListBox x:Name="SchoolStudyImpact" Grid.Row="2" Classes="object-list study-review" AutomationProperties.Name="逐班核对变更"
                     ScrollViewer.AllowAutoHide="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:SchoolStudyImpactView">
                  <Grid Classes="study-impact" ColumnDefinitions="0.85*,1.4*,1.4*" ColumnSpacing="8">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" Classes="label" TextWrapping="Wrap"/>
                      <Grid ColumnDefinitions="Auto,*">
                        <Border IsVisible="{Binding NeedsReview}" Width="3" Margin="0,2,6,2" CornerRadius="1.5" Background="{DynamicResource WarningBrush}"/>
                        <TextBlock Grid.Column="1" Classes.changed="{Binding NeedsReview}" Text="{Binding Action}" TextWrapping="Wrap"/>
                      </Grid>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="2" Text="{Binding After}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="13,8">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <WrapPanel ItemSpacing="6" LineSpacing="4">
          <Button x:Name="StudyEditClose" Classes="action" Content="返回" Click="CloseEditor"/>
          <Button x:Name="StudyMonitorGrade" Classes="action" Content="编辑本年级监测" IsVisible="False" Click="OpenMonitoringGrade"/>
          <Button x:Name="StudyReadSave" Classes="action" Content="核对本次回执" Click="CheckSave" IsVisible="False"/>
        </WrapPanel>
        <Button x:Name="StudyEditPreview" Grid.Column="1" Classes="action" Content="预览逐班影响" Click="Preview"/>
        <Button x:Name="StudyEditSave" Grid.Column="2" Classes="action accent" Content="确认保存" Click="Save"/>
      </Grid>
    </Border>
  </Grid>
  <Window.Styles>
    <Style Selector="ListBox.study-review > ListBoxItem">
      <Setter Property="FocusAdorner">
        <Template><Border CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" IsHitTestVisible="False"/></Template>
      </Setter>
    </Style>
    <Style Selector="Grid.study-impact TextBlock.changed">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>
</Window>
