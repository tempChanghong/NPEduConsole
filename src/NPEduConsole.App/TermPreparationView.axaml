<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:NPEduConsole.Core" x:Class="NPEduConsole.App.TermPreparationView">
  <UserControl.Styles>
    <Style Selector="TextBlock.term-notice.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <!-- 阻断/提醒逐条是可聚焦的 Border，没有模板就看不到键盘焦点落在哪一条。
         常态也留 2px 透明边框，聚焦时只换颜色，行高不跳。 -->
    <Style Selector="#TermBlockerItems > Border, #TermReminderItems > Border">
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="#TermBlockerItems > Border:focus, #TermReminderItems > Border:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="StackPanel.screen-compact, StackPanel.screen-details, Grid.compact-check Grid.screen-columns">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Grid.compact-check StackPanel.screen-compact, ListBoxItem:selected StackPanel.screen-details">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
      <StackPanel Spacing="4">
        <TextBlock x:Name="TermHeading" Text="学期管理" FontSize="24" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="TermScope" Classes="muted" TextWrapping="Wrap"/>
        <!-- 核对/确认页把「要启用哪个学期、几台大屏要处理」固定在页头，窄窗滚到下面也还看得见。 -->
        <TextBlock x:Name="TermActivationHeadline" Classes="label" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsVisible="False"
                   AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6" Margin="16,10">
      <TextBlock x:Name="TermNotice" Classes="term-notice" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Polite"/>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="TermScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
          <Grid Margin="0,0,6,0">
            <Grid x:Name="TermDirectory">
              <Border x:Name="ActiveTermCard" Classes="card" Padding="12" VerticalAlignment="Top">
                <StackPanel Spacing="7">
                  <TextBlock Text="正在使用" FontSize="17" Classes="label"/>
                  <TextBlock x:Name="ActiveTermName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="ActiveTermDates" Classes="muted" TextWrapping="Wrap"/>
                  <Separator/>
                  <TextBlock Text="正在查看" FontSize="17" Classes="label"/>
                  <TextBlock x:Name="ViewedTermName" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="ViewedTermDetails" Classes="muted" TextWrapping="Wrap"/>
                  <WrapPanel ItemSpacing="8" LineSpacing="5">
                    <Button x:Name="TermManageClasses" Classes="action" Content="班级与名单" Click="TermManageClassesClicked" IsVisible="False"/>
                    <Button x:Name="TermViewDiagnostics" Classes="action" Content="查看诊断" Click="TermDiagnosticsClicked" IsVisible="False"/>
                    <Button x:Name="TermEditDetails" Classes="action" Content="更正名称与日期" Click="TermDetailsClicked" IsVisible="False"/>
                    <Button x:Name="TermBlankDraft" Classes="action" Content="建立空白草稿" Click="TermDetailsClicked" IsVisible="False"/>
                    <Button x:Name="TermDetailsVerify" Classes="action" Content="核对学期资料" Click="TermDetailsClicked" IsVisible="False"/>
                    <Button x:Name="TermManageTeaching" Classes="action" Content="教学安排与师资" Click="TermManageTeachingClicked" IsVisible="False"/>
                    <Button x:Name="TermStatusActivate" Classes="action" Content="预览启用" Click="StatusActivateClicked"/>
                    <Button x:Name="TermStatusReceiptButton" Classes="action" Content="核对学期操作" Click="StatusReceiptClicked" IsVisible="False"/>
                  </WrapPanel>
                  <Expander x:Name="TermMoreActions" Header="更多操作" IsVisible="False" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,5,0,0" Spacing="6">
                      <WrapPanel ItemSpacing="8" LineSpacing="5">
                        <Button x:Name="TermStatusArchive" Classes="action" Content="单独归档" Click="StatusArchiveClicked"/>
                        <Button x:Name="TermStatusDraft" Classes="action" Content="转回草稿" Click="StatusDraftClicked"/>
                      </WrapPanel>
                      <ComboBox x:Name="TermStatusHistoryPicker" HorizontalAlignment="Stretch" IsVisible="False"
                                AutomationProperties.Name="本学期的本人历史操作"/>
                      <Button x:Name="TermStatusHistoryOpen" Classes="action" Content="查看所选历史回执" IsVisible="False"
                              Click="StatusHistoryClicked"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Border x:Name="DraftTermsCard" Classes="card" Padding="12">
                <StackPanel Spacing="7">
                  <TextBlock Text="本校学期" FontSize="17" Classes="label"/>
                  <ComboBox x:Name="TermFilter" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="TermFilterChanged"
                            AutomationProperties.Name="按状态筛选学期">
                    <ComboBoxItem Content="全部"/><ComboBoxItem Content="启用中"/>
                    <ComboBoxItem Content="草稿"/><ComboBoxItem Content="已归档"/>
                  </ComboBox>
                  <TextBlock x:Name="DraftListEmpty" Classes="muted" TextWrapping="Wrap" IsVisible="False"/>
                  <ListBox x:Name="PreparedTerms" Classes="object-list" Background="Transparent" BorderThickness="0" MinHeight="120" MaxHeight="240"
                           SelectionChanged="DraftSelected" KeyDown="DraftListKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False" AutomationProperties.Name="本校学期目录">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="core:ManagedAcademicTerm">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding YearHeading}" Classes="muted" IsVisible="{Binding StartsYear}" Margin="0,4,0,1"/>
                          <TextBlock Text="{Binding Name}" Classes="label" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Badge}" Classes="muted"/>
                          <TextBlock Text="{Binding Dates}" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </Grid>
            <Grid x:Name="TermCreateView" IsVisible="False">
              <Border x:Name="TermSettingsCard" Classes="card" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="草稿信息" FontSize="17" Classes="label"/>
                  <TextBlock x:Name="TermDraftSource" Classes="muted" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="9" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                    <StackPanel Spacing="3">
                      <TextBlock Text="学年" Classes="label"/>
                      <TextBox x:Name="TermDraftYear" MaxLength="4" TextChanged="InputChanged" AutomationProperties.Name="目标学年"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="学期" Classes="label"/>
                      <ComboBox x:Name="TermDraftSemester" HorizontalAlignment="Stretch" SelectionChanged="SemesterChanged" AutomationProperties.Name="目标学期">
                        <ComboBoxItem Content="第一学期"/><ComboBoxItem Content="第二学期"/><ComboBoxItem Content="第三学期"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                      <TextBlock Text="名称" Classes="label"/>
                      <TextBox x:Name="TermDraftName" MaxLength="191" TextChanged="InputChanged" AutomationProperties.Name="目标学期名称"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="3">
                      <TextBlock Text="开始日期" Classes="label"/>
                      <TextBox x:Name="TermStartDate" PlaceholderText="YYYY-MM-DD" MaxLength="10" TextChanged="InputChanged" AutomationProperties.Name="开始日期"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                      <TextBlock Text="结束日期" Classes="label"/>
                      <TextBox x:Name="TermEndDate" PlaceholderText="YYYY-MM-DD" MaxLength="10" TextChanged="InputChanged" AutomationProperties.Name="结束日期"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="继承范围" FontSize="16" Classes="label"/>
                  <CheckBox x:Name="CarryTermMembers" Content="教学空间成员权限" IsChecked="True" IsCheckedChanged="CarryChanged"/>
                  <CheckBox x:Name="CarryTermTeaching" Content="有效任课" IsChecked="True" IsCheckedChanged="CarryChanged"/>
                  <CheckBox x:Name="CarryTermDuties" Content="有效班级与年级职责" IsChecked="True" IsCheckedChanged="CarryChanged"/>
                  <CheckBox x:Name="CarryTermInvites" Content="未认领的 OAuth 邀请" IsCheckedChanged="CarryChanged"/>
                  <TextBlock x:Name="TermAccessNote" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border x:Name="TermReviewCard" Classes="card" Padding="12">
                <StackPanel Spacing="7">
                  <TextBlock Text="继承预览" FontSize="17" Classes="label"/>
                  <TextBlock x:Name="TermPreviewSummary" Text="请选择继承范围，再读取预览。" Classes="muted" TextWrapping="Wrap"/>
                  <ComboBox x:Name="TermPreviewItems" SelectionChanged="PreviewItemChanged" HorizontalAlignment="Stretch" IsVisible="False"
                            AutomationProperties.Name="按班级、教学班或年级核对继承详情"/>
                  <TextBlock x:Name="TermPreviewDetails" TextWrapping="Wrap" IsVisible="False"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>
        <Grid x:Name="TermCheckView" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="6">
          <TabStrip SelectedIndex="0" AutomationProperties.Name="检查内容">
            <TabStripItem x:Name="TermScreensTab" FontSize="15"><TextBlock x:Name="TermScreensTabLabel" Text="大屏影响"/></TabStripItem>
            <TabStripItem x:Name="TermRisksTab" FontSize="15"><TextBlock x:Name="TermRisksTabLabel" Text="教务与变更"/></TabStripItem>
          </TabStrip>
          <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="5" IsVisible="{Binding #TermScreensTab.IsSelected}">
            <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="12">
              <TextBox x:Name="TermScreenSearch" Classes="search-field" HorizontalAlignment="Stretch"
                       PlaceholderText="查找屏名、班级或绑定编号" TextChanged="ScreenSearchChanged" KeyDown="ScreenSearchKeyDown"
                       AutomationProperties.Name="查找拟迁移大屏"/>
              <TextBlock Grid.Column="1" x:Name="TermScreenSummary" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
            <Grid Grid.Row="1" Classes="screen-columns" ColumnDefinitions="1.05*,1.2*,1*,1.5*" ColumnSpacing="12" Margin="13,1">
              <TextBlock Text="大屏" Classes="label"/><TextBlock Grid.Column="1" Text="原班级" Classes="label"/>
              <TextBlock Grid.Column="2" Text="拟迁入" Classes="label"/><TextBlock Grid.Column="3" Text="启用后" Classes="label"/>
            </Grid>
            <ListBox Grid.Row="2" x:Name="TermScreenRows" Classes="object-list" Background="{DynamicResource SurfaceBrush}"
                     CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="逐台大屏影响">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TermDraftScreenImpact">
                  <Grid AutomationProperties.AutomationId="{Binding BindingId}">
                    <Grid Classes="screen-columns" ColumnDefinitions="1.05*,1.2*,1*,1.5*" ColumnSpacing="12" Margin="0,3">
                      <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" Classes="label" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BindingId}" Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Original}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="2" Text="{Binding Target}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="3" Text="{Binding Impact}" TextWrapping="Wrap"/>
                    </Grid>
                    <StackPanel Classes="screen-compact" Spacing="3">
                      <TextBlock Text="{Binding Name}" Classes="label" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding BindingId, StringFormat='绑定编号 {0}'}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                      <StackPanel Classes="screen-details" Spacing="2">
                        <TextBlock Text="{Binding Original, StringFormat='原班级　{0}'}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Target, StringFormat='拟迁入　{0}'}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Impact}" Classes="label" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" x:Name="TermNoScreenMatches" Classes="muted" Margin="14" IsVisible="False" Text="没有符合搜索条件的大屏。"/>
          </Grid>
          <ScrollViewer x:Name="TermRiskScroll" Grid.Row="1" IsVisible="{Binding #TermRisksTab.IsSelected}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="0,0,6,0">
              <ItemsControl x:Name="TermActivationChanges" IsVisible="False">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="term-notice error"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel x:Name="TermChangedScreenLinks" Spacing="4"/>
              <Border x:Name="TermBlockersCard" Classes="card" Padding="12">
                <StackPanel Spacing="3">
                  <TextBlock x:Name="TermBlockersSummary" Classes="label" TextWrapping="Wrap"/>
                  <StackPanel x:Name="TermBlockerItems" Spacing="3"/>
                </StackPanel>
              </Border>
              <Expander x:Name="TermReminderExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header><TextBlock x:Name="TermRemindersSummary" TextWrapping="Wrap"/></Expander.Header>
                <StackPanel x:Name="TermReminderItems" Spacing="3"/>
              </Expander>
              <StackPanel Spacing="4">
                <TextBlock x:Name="TermCheckTarget" FontSize="16" Classes="label"/>
                <TextBlock x:Name="TermCheckDates" Classes="muted"/>
                <TextBlock x:Name="TermCheckStatus" TextWrapping="Wrap"/>
                <TextBlock x:Name="TermCheckReceiptCounts" TextWrapping="Wrap" IsVisible="False"/>
                <WrapPanel ItemSpacing="6" LineSpacing="4">
                  <Button x:Name="TermPrepareClasses" Classes="action" Content="准备班级与名单" Click="TermPrepareClassesClicked" IsVisible="False"/>
                  <Button x:Name="TermPrepareTeaching" Classes="action" Content="准备教学安排与师资" Click="TermPrepareTeachingClicked" IsVisible="False"/>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <!-- 结果页不进滚动区：启用后的学期名与待处理台数固定在顶上，下面只有逐台列表在滚动。 -->
        <Grid x:Name="TermActivationResultView" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8">
          <Border Classes="card" Padding="12">
            <StackPanel Spacing="5">
              <TextBlock x:Name="TermActivatedName" Classes="label" FontSize="20" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="TermArchivedName" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="TermActivatedSummary" Classes="label" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Classes="card" Padding="12">
            <Grid RowDefinitions="Auto,*" RowSpacing="7">
              <TextBlock Text="逐台大屏" FontSize="17" Classes="label"/>
              <ListBox x:Name="TermActivatedScreens" Grid.Row="1" Classes="object-list" Background="Transparent" BorderThickness="0"
                       MinHeight="120" VerticalAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False"
                       SelectionChanged="ActivationSelectionChanged" AutomationProperties.Name="启用后逐台大屏办理状态">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:TermActivatedScreen">
                    <StackPanel Spacing="3" AutomationProperties.AutomationId="{Binding BindingId}">
                      <TextBlock Text="{Binding Name}" Classes="label" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding BindingId, StringFormat='绑定编号 {0}'}" Classes="muted" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Original, StringFormat='原班级　{0}'}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Target, StringFormat='新班级　{0}'}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding PlacementDetails}" IsVisible="{Binding HasPlacement}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Outcome}" Classes="label" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <WrapPanel ItemSpacing="8" LineSpacing="4">
          <Button x:Name="TermBack" Classes="action" Content="关闭" Click="BackClicked"/>
          <Button x:Name="TermRefresh" Classes="action" Content="刷新" Click="RefreshClicked"/>
          <Button x:Name="TermPreviewButton" Classes="action" Content="预览继承" Click="PreviewClicked" IsVisible="False"/>
          <Button x:Name="TermExistingButton" Classes="action" Content="检查现有草稿" Click="ExistingClicked" IsVisible="False"/>
          <Button x:Name="TermActivationOptions" Classes="action" Content="选择迁屏与启用方式" Click="DraftStatusActivateClicked" IsVisible="False"/>
          <Button x:Name="TermOrganizationImport" Classes="action" Content="导入草稿组织" Click="OrganizationImportClicked" IsVisible="False"/>
          <Button x:Name="TermDiscard" Classes="action" Content="放弃输入" Click="DiscardClicked" IsVisible="False"/>
          <Button x:Name="TermLatestActivation" Classes="action" Content="上次启用结果" Click="OpenLatestActivation" IsVisible="False"/>
          <Button x:Name="TermConfirmCancel" Classes="action" Content="取消启用" Click="CancelActivationConfirmation" IsVisible="False"/>
          <Button x:Name="TermWeb" Classes="action" Content="网页学期管理" Click="WebClicked" IsVisible="False"/>
        </WrapPanel>
        <!-- 窄窗按钮换行时主操作不要被拉成两行高。 -->
        <Button x:Name="TermPrimary" Grid.Column="1" Classes="action accent" Content="新建草稿" Click="PrimaryClicked" VerticalAlignment="Top"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
