<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:NPEduConsole.Core" x:Class="NPEduConsole.App.TeacherAccountsView">
  <UserControl.Styles>
    <Style Selector="TextBlock.account-notice.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="Border#TeacherStatusConfirmation">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Border#TeacherStatusConfirmation.disable">
      <Setter Property="Background" Value="{DynamicResource ErrorTintBrush}"/>
    </Style>
    <Style Selector="Button#ConfirmTeacherStatus.disable">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    <Style Selector="Button#CancelTeacherStatus:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,9">
      <StackPanel Spacing="2">
        <TextBlock Text="教师账号" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="TeacherAccountsScope" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6" Margin="18,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="TeacherAccountsNotice" Classes="account-notice" TextWrapping="Wrap" VerticalAlignment="Center"
                   IsVisible="False" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="TeacherOtherReceipt" Grid.Column="1" Content="核对其他回执" Classes="action"
                Click="OtherReceiptClicked" IsVisible="False" VerticalAlignment="Center"/>
      </Grid>
      <Grid x:Name="TeacherAccountsWorkspace" Grid.Row="1">
        <Border x:Name="TeacherListPane" Classes="card" Padding="10">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox x:Name="TeacherAccountSearch" PlaceholderText="按姓名或短账号查找" TextChanged="SearchChanged" AutomationProperties.Name="查找教师账号"/>
              <Button x:Name="OpenTeacherDetails" Grid.Column="1" Content="查看账号" Classes="action" Click="OpenDetailsClicked" IsVisible="False"/>
              <Button x:Name="NewTeacherAccountButton" Grid.Column="2" Content="新建教师" Classes="action accent" Click="CreateClicked" IsVisible="False"/>
            </Grid>
            <TextBlock x:Name="TeacherListMessage" Grid.Row="1" Classes="muted" TextWrapping="Wrap" IsVisible="False"/>
            <ListBox x:Name="TeacherAccountRows" Grid.Row="2" Classes="object-list" SelectionChanged="Selected" KeyDown="RowsKeyDown"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False" AutomationProperties.Name="本校教师账号">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:ManagedTeacherAccount">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Display}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Classes="muted"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
        <Border x:Name="TeacherDetailsPane" Classes="card" Padding="10">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
            <StackPanel Spacing="4">
              <Button x:Name="BackToTeacherList" Content="返回教师列表" Classes="action" HorizontalAlignment="Left" Click="BackClicked" IsVisible="False"/>
              <TextBlock x:Name="TeacherDetailName" FontSize="20" Classes="label" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer x:Name="TeacherDetailsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="TeacherDetailData" Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="账号状态" Classes="label"/>
                    <TextBlock x:Name="TeacherDetailState"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="最近登录" Classes="label"/>
                    <TextBlock x:Name="TeacherDetailLogin"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="TeacherDetailAccess" Classes="muted" TextWrapping="Wrap"/>
                <StackPanel Spacing="4">
                  <TextBlock Text="当前学期任课" Classes="label"/>
                  <StackPanel x:Name="TeacherDetailAssignments" Spacing="4"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="当前学期职责" Classes="label"/>
                  <StackPanel x:Name="TeacherDetailDuties" Spacing="4"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <Border x:Name="TeacherStatusConfirmation" Grid.Row="2" CornerRadius="8" Padding="10,8" IsVisible="False">
              <StackPanel Spacing="6">
                <TextBlock x:Name="TeacherStatusExplanation" TextWrapping="Wrap"/>
                <WrapPanel ItemSpacing="7" LineSpacing="4">
                  <Button x:Name="ConfirmTeacherStatus" Classes="action" Click="ConfirmStatusClicked"/>
                  <Button x:Name="CancelTeacherStatus" Content="取消" Classes="action" Click="CancelStatusClicked"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <WrapPanel x:Name="TeacherDetailActions" Grid.Row="2" ItemSpacing="7" LineSpacing="4">
              <Button x:Name="ChangeTeacherStatus" Classes="action" Click="ChangeStatusClicked"/>
              <Button x:Name="ResetTeacherPin" Content="重置 PIN" Classes="action" Click="ResetClicked" IsVisible="False"/>
              <Button x:Name="TeacherSchoolAccount" Content="账号与权限" Classes="action" Click="OpenSchoolAccountClicked"/>
            </WrapPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,7">
      <WrapPanel ItemSpacing="7" LineSpacing="4">
        <Button x:Name="TeacherAccountRefresh" Content="刷新目录" Classes="action" Click="RefreshClicked"/>
        <Button x:Name="TeacherAccountBulk" Content="批量导入与分配" Classes="action" IsEnabled="False" Click="OpenBulkClicked"/>
        <Button x:Name="TeacherAccountsSchoolProfile" Content="教师登录设置" Classes="action" Click="OpenSchoolProfileClicked" IsVisible="False"/>
        <Button x:Name="CloseTeacherAccountsButton" Content="关闭" Classes="action" Click="CloseClicked"/>
      </WrapPanel>
    </Border>
  </Grid>
</UserControl>
