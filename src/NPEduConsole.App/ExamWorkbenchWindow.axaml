<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App" x:Class="NPEduConsole.App.ExamWorkbenchWindow"
        Title="考试与放映" Width="1160" Height="780" MinWidth="700" MinHeight="440" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
      <StackPanel Spacing="4">
        <TextBlock Text="考试与放映" FontSize="23" FontWeight="SemiBold" />
        <TextBlock x:Name="ExamTargetText" Classes="muted" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="原生设备" VerticalAlignment="Center" Classes="muted" />
          <ComboBox x:Name="ExamDevicePicker" Grid.Column="1" HorizontalAlignment="Left" MaxWidth="520"
                    AutomationProperties.Name="为此大屏选择原生设备" SelectionChanged="DeviceChanged" />
        </Grid>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" x:Name="ExamScroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="15,9" Spacing="8">
        <TextBlock x:Name="ExamNotice" Classes="muted" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="5">
            <TextBlock x:Name="ExamPhase" FontSize="20" FontWeight="SemiBold" Text="正在核对设备" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ExamNextStep" TextWrapping="Wrap" />
            <TextBlock x:Name="ExamPlayerEvidence" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="ExamOperationResult" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border x:Name="ExamSchedulePanel" Classes="card" Padding="12" IsVisible="False">
          <StackPanel Spacing="6">
            <TextBlock x:Name="ExamScheduleTitle" FontSize="17" Classes="label" TextWrapping="Wrap" />
            <local:ExamScheduleView x:Name="ExamSchedule" />
          </StackPanel>
        </Border>
        <Border x:Name="ExamPreflight" Classes="card" Padding="12">
          <StackPanel Spacing="5">
            <TextBlock Text="考前核对" Classes="label" FontSize="17" />
            <TextBlock x:Name="ExamRuntimeCheck" TextWrapping="Wrap" />
            <TextBlock x:Name="ExamPlanCheck" TextWrapping="Wrap" />
            <TextBlock x:Name="ExamFileNote" Classes="muted" TextWrapping="Wrap" />
            <Button x:Name="ExamChooseFile" Classes="action" Content="选择考试方案" Click="PickClicked" />
            <TextBlock x:Name="ExamEnvironmentImpact" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Expander x:Name="ExamDiagnostics" Header="诊断与最近操作" HorizontalAlignment="Stretch">
          <StackPanel Spacing="5" Margin="5">
            <TextBlock x:Name="ExamDiagnosticText" Classes="muted" TextWrapping="Wrap" />
            <TextBlock x:Name="ExamHistoryText" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,7">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <WrapPanel ItemSpacing="6" LineSpacing="5">
          <Button x:Name="ExamBack" Classes="action" Content="返回" Click="BackClicked" />
          <Button x:Name="ExamRefresh" Classes="action" Content="核对最新状态" Click="RefreshClicked" />
          <Button x:Name="ExamCancel" Classes="action" Content="取消未开始的操作" Click="CancelClicked" IsVisible="False" />
          <Button x:Name="ExamRetry" Classes="action" Content="按原请求重试" Click="RetryClicked" IsVisible="False" />
        </WrapPanel>
        <Button x:Name="ExamPrimary" Grid.Column="1" Classes="action accent" Click="PrimaryClicked" IsVisible="False" MaxWidth="350">
          <TextBlock x:Name="ExamPrimaryLabel" TextWrapping="Wrap" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
