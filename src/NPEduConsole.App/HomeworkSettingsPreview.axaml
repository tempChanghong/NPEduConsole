<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NPEduConsole.App.HomeworkSettingsPreview">
    <UserControl.Styles>
        <Style Selector="Button.hw-word">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.hw-word:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.hw-word:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="TextBlock.hw-head">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style Selector="TextBlock.hw-note">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.hw-deadline">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
        <Grid Grid.Row="0" x:Name="HomeworkPreviewSubjectRow" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="2">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="适用学科" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="HomeworkPreviewSubject"
                      MinWidth="168" SelectionChanged="SubjectChanged"
                      AutomationProperties.Name="适用学科" />
            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="HomeworkPreviewScope" Classes="muted"
                       TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="HomeworkPreviewSubjectNote" Classes="hw-note"
                       IsVisible="False" Margin="0,2,0,0" />
        </Grid>

        <Border Grid.Row="1" x:Name="HomeworkPreviewNotice" IsVisible="False"
                BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" CornerRadius="6" Padding="10,7">
            <TextBlock x:Name="HomeworkPreviewNoticeText" Classes="hw-note" />
        </Border>

        <TextBlock Grid.Row="2" x:Name="HomeworkPreviewHint" Classes="hw-note" />

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="HomeworkPreviewWordsPanel">
                    <TextBlock Text="作业正文（试填）" Classes="hw-head" />
                    <TextBox x:Name="HomeworkPreviewBody" Height="66" AcceptsReturn="True"
                             TextWrapping="Wrap" PlaceholderText="在这里输入一段作业，然后用下面的词条试插。"
                             TextChanged="BodyChanged" AutomationProperties.Name="作业正文试填" />
                    <TextBlock x:Name="HomeworkPreviewCursor" Classes="hw-note" Margin="0,4,0,0" />
                    <StackPanel x:Name="HomeworkPreviewGroups" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel x:Name="HomeworkPreviewDeadlinesPanel" IsVisible="False">
                    <TextBlock Text="基准日" Classes="hw-head" />
                    <DatePicker x:Name="HomeworkPreviewBaseDate" SelectedDateChanged="BaseDateChanged"
                                AutomationProperties.Name="快捷截止时间的基准日" />
                    <TextBlock x:Name="HomeworkPreviewBaseHint" Classes="hw-note" Margin="0,4,0,0" />
                    <StackPanel x:Name="HomeworkPreviewDeadlines" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
