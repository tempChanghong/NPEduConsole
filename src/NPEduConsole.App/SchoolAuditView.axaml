<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NPEduConsole.App" x:Class="NPEduConsole.App.SchoolAuditView">
  <UserControl.Styles>
    <Style Selector="TextBlock.audit-failed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="14" Margin="29,24,29,25">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="5">
        <TextBlock x:Name="AuditSchoolName" Classes="muted" />
        <TextBlock Text="审计记录" FontSize="27" FontWeight="SemiBold" />
      </StackPanel>
      <Button Grid.Column="1" Content="返回工作区" Classes="action" Click="BackClicked" VerticalAlignment="Center" />
    </Grid>

    <Grid x:Name="AuditSearch" Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12">
      <Border Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,1.25*,*" ColumnSpacing="12" RowSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Text="操作来源" Classes="label" />
            <ComboBox x:Name="AuditActorFilter" HorizontalAlignment="Stretch" AutomationProperties.Name="操作来源" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="操作类型" Classes="label" />
            <ComboBox x:Name="AuditActionFilter" HorizontalAlignment="Stretch" AutomationProperties.Name="操作类型" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="执行结果" Classes="label" />
            <ComboBox x:Name="AuditResultFilter" HorizontalAlignment="Stretch" AutomationProperties.Name="执行结果" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="开始日期（本地）" Classes="label" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBox x:Name="AuditFromDate" MaxLength="10" PlaceholderText="YYYY-MM-DD" AutomationProperties.Name="开始日期（本地）" />
              <Button x:Name="OpenAuditFromCalendar" Grid.Column="1" Content="日历" Classes="action" Padding="7,8"
                      AutomationProperties.Name="选择开始日期" Click="OpenCalendarClicked" />
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
            <TextBlock Text="结束日期（含当天）" Classes="label" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBox x:Name="AuditToDate" MaxLength="10" PlaceholderText="YYYY-MM-DD" AutomationProperties.Name="结束日期（含当天）" />
              <Button x:Name="OpenAuditToCalendar" Grid.Column="1" Content="日历" Classes="action" Padding="7,8"
                      AutomationProperties.Name="选择结束日期" Click="OpenCalendarClicked" />
            </Grid>
          </StackPanel>
          <Button x:Name="QueryAuditButton" Grid.Row="1" Grid.Column="2" Content="刷新" Classes="action accent"
                  Click="QueryClicked" VerticalAlignment="Bottom" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="card" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
          <TextBlock x:Name="AuditStatus" Classes="muted" Margin="6,3,6,0" AutomationProperties.LiveSetting="Polite" IsVisible="False" />
          <ListBox x:Name="AuditList" Grid.Row="1" Background="Transparent" AutomationProperties.Name="审计记录列表" KeyDown="AuditListKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:SchoolAuditRow">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="5,6">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ActorAndTime}" Classes="muted" />
                    <TextBlock Text="{Binding ActionAndEntity}" Classes="muted" IsVisible="{Binding HasSecondaryLine}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Result}" Classes="label" Classes.audit-failed="{Binding Failed}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="查看详情" Classes="action" MinHeight="36" VerticalAlignment="Center"
                          Click="ShowDetailsClicked" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button x:Name="MoreAuditButton" Grid.Row="2" Content="加载更多" Classes="action" Click="ReadMoreClicked" IsVisible="False"
                  HorizontalAlignment="Right" Margin="6,0,6,4" />
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="AuditDetails" Grid.Row="1" Classes="card" Padding="16" IsVisible="False">
      <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Text="审计详情" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="CloseAuditDetailsButton" Grid.Column="1" Content="返回记录" Classes="action" Click="CloseDetailsClicked" />
        </Grid>
        <ScrollViewer x:Name="AuditDetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="0,0,10,0">
            <TextBlock x:Name="AuditDetailTitle" Classes="label" FontSize="16" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="78,*" ColumnSpacing="10" RowSpacing="8">
              <TextBlock Text="操作者" Classes="muted" />
              <SelectableTextBlock x:Name="AuditDetailActor" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="本地时间" Classes="muted" />
              <SelectableTextBlock x:Name="AuditDetailTime" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="操作" Classes="muted" />
              <SelectableTextBlock x:Name="AuditDetailAction" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="对象" Classes="muted" />
              <SelectableTextBlock x:Name="AuditDetailEntity" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="请求" Classes="muted" />
              <SelectableTextBlock x:Name="AuditDetailRequest" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Text="结果" Classes="muted" />
              <SelectableTextBlock x:Name="AuditDetailResult" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" Text="来源 IP" Classes="muted" />
              <SelectableTextBlock x:Name="AuditDetailIp" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
            <StackPanel x:Name="AuditDetailParameters" Spacing="6" IsVisible="False">
              <TextBlock Text="脱敏后的操作参数" Classes="label" />
              <Border Background="{DynamicResource CanvasBrush}" Padding="12" CornerRadius="8">
                <SelectableTextBlock x:Name="AuditDetailMetadata" FontFamily="Consolas, Microsoft YaHei UI" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
