<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NPEduConsole.App.DeviceRunReportDetail">
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="ReportScroll" HorizontalScrollBarVisibility="Disabled" Focusable="True"
                AutomationProperties.Name="报告详情">
    <Panel Margin="0,0,8,0">
      <TextBlock x:Name="ReportEmpty" Classes="muted" Text="选择一份运行报告查看详情" />
      <StackPanel x:Name="ReportBody" Spacing="8" IsVisible="False">
        <StackPanel Spacing="3">
          <TextBlock x:Name="ReportHeading" Classes="label" FontSize="18" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="ReportWindow" Classes="caption" />
        </StackPanel>
        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12,7">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Classes="caption" Text="有效采样" />
              <TextBlock x:Name="SummarySampled" Classes="metric" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="caption" Text="总时长" />
              <TextBlock x:Name="SummaryElapsed" Classes="metric" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="caption" Text="有效覆盖率" />
              <TextBlock x:Name="SummaryCoverage" Classes="metric" />
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="ReportHintPanel" Background="{DynamicResource WarningTintBrush}" CornerRadius="8" Padding="10,6" IsVisible="False">
          <TextBlock x:Name="ReportHints" Classes="warn" FontSize="12" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <TextBlock Classes="label" Text="原始采集 · dBFS" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <StackPanel>
            <TextBlock Classes="caption" Text="能量平均" />
            <TextBlock x:Name="SummaryEnergy" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="caption" Text="采样峰值" />
            <TextBlock x:Name="SummaryPeak" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="caption" Text="削波占比" />
            <TextBlock x:Name="SummaryClipped" />
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" />
        <TextBlock Classes="label" Text="外部参考估算 · dB(A)" />
        <TextBlock x:Name="EstimateStatus" />
        <StackPanel x:Name="EstimateMeasurements" Spacing="6">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="6">
            <StackPanel>
              <TextBlock x:Name="EstimateEnergyLabel" Classes="caption" Text="平滑电平能量均值" />
              <TextBlock x:Name="EstimateEnergy" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="caption" Text="最高平滑电平" />
              <TextBlock x:Name="EstimatePeak" />
            </StackPanel>
            <StackPanel Grid.Row="1">
              <TextBlock Classes="caption" Text="估算有效采样" />
              <TextBlock x:Name="EstimateSampled" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1">
              <TextBlock Classes="caption" Text="估算有效覆盖率" />
              <TextBlock x:Name="EstimateCoverage" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="caption" Text="参考换算范围为 30–130 dB(A)，仅计入匹配参考、预热完成且削波不超过 0.1% 的区间。该估算值未经仪器验证。" />
        </StackPanel>
        <Expander x:Name="ReportIdentity" Header="会话、归属与时间依据" HorizontalAlignment="Stretch"
                  Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" CornerRadius="8"
                  HorizontalContentAlignment="Stretch">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Classes="caption" Text="入库归属" />
            <TextBlock x:Name="Ownership" Grid.Column="1" />
            <TextBlock Grid.Row="1" Classes="caption" Text="自习规则" />
            <TextBlock x:Name="StudyWindow" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="2" Classes="caption" Text="会话编号" />
            <TextBlock x:Name="SessionText" Grid.Row="2" Grid.Column="1" />
            <TextBlock x:Name="EndReasonLabel" Grid.Row="3" Classes="caption" Text="结束原因" />
            <TextBlock x:Name="EndReason" Grid.Row="3" Grid.Column="1" />
            <TextBlock x:Name="ReportTrace" Grid.Row="4" Grid.ColumnSpan="2" Classes="caption" />
          </Grid>
        </Expander>
      </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
