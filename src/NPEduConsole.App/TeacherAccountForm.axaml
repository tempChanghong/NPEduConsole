<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NPEduConsole.App.TeacherAccountForm" Title="教师账号" Width="790" Height="510" MinWidth="640" MinHeight="455"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- 外壳的全局样式里没有错误文本样式，通知栏靠 Classes.Set("error") 切换，这里补上，避免错误提示与普通提示同色。 -->
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,12">
      <StackPanel Spacing="3">
        <TextBlock x:Name="TeacherFormHeading" Text="新建教师账号" Classes="label" FontSize="25"/>
        <TextBlock x:Name="TeacherFormScope" Classes="muted" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,12" Spacing="10" MaxWidth="930">
        <Border x:Name="TeacherFormNoticeBox" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10,7" IsVisible="False">
          <TextBlock x:Name="TeacherFormNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Border x:Name="TeacherFormCard" Classes="card" Padding="14,12" IsVisible="False">
          <StackPanel Spacing="10">
            <Grid x:Name="TeacherIdentityFields" ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="教师姓名" Classes="label"/>
                <TextBox x:Name="TeacherFormName" AutomationProperties.Name="教师姓名"/>
                <TextBlock x:Name="TeacherFormNameError" IsVisible="False" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="本校短账号" Classes="label"/>
                <TextBox x:Name="TeacherFormUsername" AutomationProperties.Name="本校短账号"/>
                <TextBlock x:Name="TeacherFormUsernameError" IsVisible="False" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="TeacherPinField" IsVisible="False" Spacing="4" MaxWidth="350" HorizontalAlignment="Left">
              <TextBlock Text="个人 PIN" Classes="label"/>
              <TextBox x:Name="TeacherFormPin" PasswordChar="●" MaxLength="8" PlaceholderText="4 至 8 位数字"
                       AutomationProperties.Name="个人 PIN"
                       AutomationProperties.HelpText="教师用它登录。窗口关闭后不再显示，管理员可随时重置。"
                       MinWidth="180"/>
              <TextBlock x:Name="TeacherFormPinError" IsVisible="False" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="TeacherFormPinHint" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
              <CheckBox x:Name="TeacherWantDelivery" Content="保存后复制或另存本次 PIN"/>
            </StackPanel>
            <TextBlock x:Name="TeacherFormExplanation" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <WrapPanel x:Name="TeacherDeliveryActions" IsVisible="False" ItemSpacing="8" LineSpacing="4">
          <Button x:Name="TeacherCopyPin" Classes="action" Content="复制本次 PIN" Click="DeliverPinClicked"/>
          <Button x:Name="TeacherSavePin" Classes="action" Content="另存本次 PIN" Click="DeliverPinClicked"/>
        </WrapPanel>
        <Button x:Name="TeacherFormAllocation" Classes="action" Content="打开邮箱分配" Click="OpenAllocationClicked" IsVisible="False" HorizontalAlignment="Left"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <WrapPanel ItemSpacing="8" LineSpacing="5">
          <Button x:Name="TeacherFormClose" Classes="action" Click="CloseClicked" Content="返回"/>
          <Button x:Name="TeacherFormCheck" Classes="action" Click="CheckClicked" Content="核对回执" IsVisible="False"/>
          <Button x:Name="TeacherFormAbandon" Classes="action" Click="AbandonClicked" Content="放弃核对" IsVisible="False"/>
        </WrapPanel>
        <Button x:Name="TeacherFormSave" Grid.Column="1" Classes="action accent" Click="SaveClicked" Content="创建教师" IsVisible="False"/>
      </Grid>
    </Border>
  </Grid>
</Window>
