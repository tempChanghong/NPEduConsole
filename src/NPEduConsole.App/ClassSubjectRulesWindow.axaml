<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App"
        x:Class="NPEduConsole.App.ClassSubjectRulesWindow"
        Title="编辑整班规则" Width="1160" Height="780" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}">
  <Window.Styles>
    <Style Selector="CheckBox.rule-confirmation">
      <Setter Property="Padding" Value="6,2,8,2"/>
      <Setter Property="FocusAdorner">
        <Template><Border CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource FocusBrush}" IsHitTestVisible="False"/></Template>
      </Setter>
    </Style>
  </Window.Styles>
  <Border Background="{DynamicResource CanvasBrush}" Padding="18,12">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Spacing="3">
        <TextBlock Text="编辑整班规则" Classes="heading" FontSize="23"/>
        <TextBlock x:Name="RulesScope" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
      <Button x:Name="RulesEditArchive" Grid.Column="1" Content="更正安排" Classes="action" IsVisible="False" Click="EditArchiveClicked"/>
    </Grid>
    <ScrollViewer x:Name="RulesNoticeScroll" Grid.Row="1" MaxHeight="75" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
      <TextBlock x:Name="RulesNotice" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </ScrollViewer>

    <Grid Grid.Row="2">
      <Grid x:Name="RulesEditor" RowDefinitions="Auto,*" RowSpacing="8">
        <Grid x:Name="RulesEditorTools" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="RulesFilter" PlaceholderText="搜索学科名称或代码" AutomationProperties.Name="搜索学科" TextChanged="FilterChanged"/>
          <Button x:Name="RulesPreset" Grid.Column="1" Classes="action" Content="套用预设…" Click="PresetClicked"/>
        </Grid>
        <Grid x:Name="RulesEditorPanes" Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="8">
          <Border x:Name="RulesEditorListPane" Classes="card" Padding="8">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
              <TextBlock Text="学校科目目录" Classes="label" Margin="4,0"/>
              <ListBox x:Name="RulesRows" Grid.Row="1" Classes="object-list" Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RowChanged" KeyDown="EditorListKeyDown" Tapped="EditorSubjectTapped"
                       AutomationProperties.Name="整班规则科目">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ClassRuleEditorLine">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="label" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="RulesOpenSubject" Grid.Row="2" Classes="action accent" Content="查看科目规则" Click="OpenEditorSubject" IsVisible="False"/>
            </Grid>
          </Border>
          <Border x:Name="RulesEditorDetailPane" Grid.Column="1" Classes="card" Padding="12">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="RulesSelectedName" Classes="label" FontSize="17" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="RulesReturnSubjects" Grid.Column="1" Classes="action" Content="返回科目列表" Click="ReturnEditorSubjects" IsVisible="False"/>
              </Grid>
              <ScrollViewer x:Name="RulesEditorScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
               <StackPanel x:Name="RulesSelected" Spacing="8">
                <TextBlock x:Name="RulesBefore" Classes="muted" TextWrapping="Wrap"/>
                <TextBlock Text="我的草稿" Classes="label"/>
                <ComboBox x:Name="RulesMode" HorizontalAlignment="Stretch" AutomationProperties.Name="授课方式" SelectionChanged="ModeChanged"/>
                <ComboBox x:Name="RulesRequirement" HorizontalAlignment="Stretch" AutomationProperties.Name="必修属性" SelectionChanged="RequirementChanged"/>
                <TextBlock x:Name="RulesRelations" Classes="muted" TextWrapping="Wrap"/>
                <StackPanel x:Name="RulesResolveDraft" Spacing="6" IsVisible="False">
                  <TextBlock x:Name="RulesOverlap" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
                  <WrapPanel>
                    <Button x:Name="RulesKeepChoice" Classes="action" Content="保留我的写法" Click="KeepChoiceClicked" Margin="0,0,6,4"/>
                    <Button Classes="action" Content="采用学校当前值" Click="UseServerClicked" Margin="0,0,0,4"/>
                  </WrapPanel>
                </StackPanel>
               </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="RulesReview" IsVisible="False" ColumnDefinitions="3*,2*" ColumnSpacing="8">
        <Border x:Name="RulesReviewListPane" Classes="card" Padding="8">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
            <TextBlock Text="逐科核对" Classes="label" Margin="4,0"/>
            <ListBox x:Name="RulesReviewRows" Grid.Row="1" Classes="object-list" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ReviewRowChanged" KeyDown="ReviewKeyDown" Tapped="ReviewSubjectTapped"
                     AutomationProperties.Name="按科核对本批调整">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ClassRuleReviewLine">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding Title}" Classes="label" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsSubject}">
                      <TextBlock Text="{Binding Before, StringFormat='原来 · {0}'}" Classes="muted" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding After, StringFormat='调整后 · {0}'}" TextWrapping="Wrap"/>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="RulesOpenReviewSubject" Grid.Row="2" Classes="action accent" Content="查看核对详情" Click="OpenReviewSubject" IsVisible="False"/>
          </Grid>
        </Border>
        <Border x:Name="RulesConfirmBox" Grid.Column="1" Classes="card" Padding="10">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock x:Name="RulesReviewTitle" Classes="label" FontSize="17" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button x:Name="RulesReturnReviewList" Grid.Column="1" Content="返回核对列表" Classes="action" Click="ReturnReviewSubjects" IsVisible="False"/>
            </Grid>
            <ScrollViewer x:Name="RulesReviewScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
             <StackPanel Spacing="8">
              <Grid x:Name="RulesReviewValues" ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Spacing="3">
                  <TextBlock Text="学校当前" Classes="muted"/>
                  <TextBlock x:Name="RulesReviewBefore" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="保存后" Classes="muted"/>
                  <TextBlock x:Name="RulesReviewAfter" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="RulesReviewDetail" TextWrapping="Wrap"/>
              <Button x:Name="RulesOpenConflict" Classes="action" Click="OpenConflictClicked" HorizontalAlignment="Left" IsVisible="False"/>
              <StackPanel x:Name="RulesSourceChecks" Spacing="6"/>
              <CheckBox x:Name="RulesClearCheck" Classes="rule-confirmation" IsVisible="False" IsCheckedChanged="ConfirmationChanged">
                <TextBlock Text="确认本班将不再开设任何科目" TextWrapping="Wrap"/>
              </CheckBox>
             </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock x:Name="RulesReviewSummary" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" IsVisible="False"/>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" ItemSpacing="6" LineSpacing="4">
      <Button x:Name="RulesClose" Classes="action" Content="关闭" Click="CloseClicked" Margin="4,0"/>
      <Button x:Name="RulesReload" Classes="action" Content="重新读取" Click="ReloadClicked" Margin="4,0"/>
      <Button x:Name="RulesBack" Classes="action" Content="返回编辑" Click="BackClicked" Margin="4,0" IsVisible="False"/>
      <Button x:Name="RulesRecheck" Classes="action" Content="核对本人回执" Click="VerifyClicked" Margin="4,0" IsVisible="False"/>
      <Button x:Name="RulesRetry" Classes="action" Content="按原编号重试" Click="RetryClicked" Margin="4,0" IsVisible="False"/>
      <Button x:Name="RulesNextUnconfirmed" Classes="action" Content="下个未核对" Click="NextUnconfirmedClicked" ToolTip.Tip="F8 · 定位下个未核对项" IsVisible="False"/>
      <Button x:Name="RulesPreview" Classes="action accent" Content="预览调整" Click="PreviewClicked" Margin="4,0"/>
      <Button x:Name="RulesSave" Classes="action accent" Content="确认保存" Click="SaveClicked" Margin="4,0" IsVisible="False"/>
      </WrapPanel>
    </Grid>
  </Grid>
  </Border>
</Window>
