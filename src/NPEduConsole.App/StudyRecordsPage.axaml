<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NPEduConsole.App" x:Class="NPEduConsole.App.StudyRecordsPage">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,9">
      <StackPanel Spacing="4">
        <TextBlock x:Name="RecordsTitle" Text="照片与退出记录" FontSize="23" Classes="label"/>
        <TextBlock x:Name="RecordsScope" TextWrapping="Wrap" Classes="muted"/>
      </StackPanel>
    </Border>
    <Grid x:Name="RecordsBody" Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="13,8">
      <WrapPanel x:Name="RecordsFilters" ItemSpacing="8" LineSpacing="5">
        <CheckBox x:Name="RecordsAllDays" Content="查看所有保留日期" IsCheckedChanged="DateChanged"/>
        <Button x:Name="RecordsRefresh" Classes="action" Content="刷新记录" Click="Refresh"/>
      </WrapPanel>
      <TextBlock Grid.Row="1" x:Name="RecordsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="False"/>
      <local:StudyRecordsView Grid.Row="2" x:Name="Records"/>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="13,8">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <Border Grid.ColumnSpan="2" x:Name="RemoveRecordPanel" IsVisible="False" Background="{DynamicResource ErrorTintBrush}"
                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,0,7" Padding="8,5">
          <TextBlock x:Name="RemoveRecordSummary" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                     AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Button Grid.Row="1" x:Name="RecordsDone" Classes="action" Content="关闭" Click="CloseRecords"/>
        <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="4">
          <Button x:Name="StudyRecordsDownload" Classes="action" Content="下载照片" IsVisible="False" Click="DownloadClicked"/>
          <Button x:Name="StudyRecordsDelete" Classes="action" Content="删除照片…" IsVisible="False" Click="DeleteClicked"/>
          <Button x:Name="RemoveRecordCancel" Classes="action" Content="保留照片" IsVisible="False" Click="CancelRemoval"/>
          <Button x:Name="RemoveRecordConfirm" Classes="action" Content="确认删除单张照片" IsVisible="False" Click="RemovePhoto"
                  Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}"/>
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
