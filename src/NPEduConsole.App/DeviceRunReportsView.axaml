<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NPEduConsole.App"
             x:Class="NPEduConsole.App.DeviceRunReportsView">
  <Panel Background="{DynamicResource CanvasBrush}">
    <Grid x:Name="ReportWorkspace" Margin="14,10" RowDefinitions="Auto,*,Auto" RowSpacing="6">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="运行报告" Classes="label" FontSize="20" />
            <TextBlock x:Name="RunReportTarget" Classes="label" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleButton x:Name="ReportLiveToggle"
                        Grid.Column="1"
                        Content="设备当下状态"
                        IsChecked="False"
                        VerticalAlignment="Center"
                        MinHeight="32"
                        Padding="10,5"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="显示或收起设备当下状态" />
        </Grid>
        <Border IsVisible="{Binding IsChecked, ElementName=ReportLiveToggle}" Classes="card" Padding="10,6">
          <StackPanel Spacing="2">
            <TextBlock x:Name="RunReportDevice" Classes="label" FontSize="13" TextWrapping="Wrap" />
            <TextBlock x:Name="RunReportLive" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="RunReportFeedback"
                   Classes="muted"
                   FontSize="12"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <Grid x:Name="RunReportColumns" Grid.Row="1" ColumnDefinitions="1*,1.6*" ColumnSpacing="10">
        <Border x:Name="RunReportListPane" Classes="card" Padding="10,8">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock Text="已结束的报告" Classes="label" VerticalAlignment="Center" />
              <ComboBox x:Name="RunReportFilter"
                        Grid.Column="1"
                        SelectedIndex="0"
                        MinHeight="32"
                        AutomationProperties.Name="筛选报告来源">
                <ComboBoxItem Content="全部来源" />
                <ComboBoxItem Content="学校排程" />
                <ComboBoxItem Content="手动自习" />
                <ComboBoxItem Content="来源待核对" />
              </ComboBox>
            </Grid>
            <TextBlock Grid.Row="1"
                       Classes="muted"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="显示最近 20 份。每台设备在服务器保留 30 天内最多 200 份。" />
            <ListBox x:Name="RunReportRows"
                     Grid.Row="2"
                     Classes="object-list"
                     Background="Transparent"
                     AutomationProperties.Name="运行报告列表"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:DeviceRunReportRow">
                  <StackPanel Spacing="2" Margin="4,5">
                    <TextBlock Text="{Binding Title}" Classes="label" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="RunReportOpen" Grid.Row="3" Classes="action accent" Content="查看报告" Click="OpenReport" />
          </Grid>
        </Border>

        <Border x:Name="RunReportDetailPane" Grid.Column="1" Classes="card" Padding="12,8">
          <Grid RowDefinitions="Auto,*" RowSpacing="4">
            <StackPanel Spacing="2">
              <TextBlock x:Name="RunReportDetailStatus"
                         IsVisible="False"
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="RunReportSessionTime"
                         IsVisible="False"
                         Classes="muted"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
            <local:DeviceRunReportDetail Grid.Row="1" x:Name="RunReportDetail" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2"
              BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,8,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
            <Button x:Name="RunReportRecords"
                    Classes="action"
                    Content="本场照片与退出记录"
                    Click="OpenRecords"
                    IsVisible="False" />
            <Button x:Name="RunReportField"
                    Classes="action"
                    Content="现场处置"
                    Click="OpenField" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button x:Name="RunReportBack" Classes="action" Content="返回" Click="GoBack" />
            <Button x:Name="RunReportRefresh" Classes="action" Content="刷新报告" Click="Refresh" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <ContentControl x:Name="ReportRecordsHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsVisible="False" />
  </Panel>
</UserControl>
