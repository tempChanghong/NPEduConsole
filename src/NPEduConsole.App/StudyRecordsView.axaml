<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NPEduConsole.App"
             x:Class="NPEduConsole.App.StudyRecordsView" KeyDown="ViewKeyDown">
  <UserControl.Styles>
    <Style Selector="ListBox.record-list > ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.record-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.record-detail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Opacity" Value="0.78" />
    </Style>
    <Style Selector="Border.record-photo">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" RowSpacing="7">
    <TextBlock x:Name="StudyRecordsStatus" Classes="muted" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
    <Grid x:Name="StudyRecordsColumns" Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="9" ClipToBounds="True">
      <Border x:Name="StudyRecordsListPane" Classes="card" Padding="10" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto" RowSpacing="6">
          <ListBox x:Name="StudyRecordsList" Classes="object-list record-list" SelectionChanged="RowSelectionChanged"
                   KeyDown="RowKeyDown" AutomationProperties.Name="自习记录列表">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:StudyRecordRow">
                <StackPanel Spacing="2" ToolTip.Tip="{Binding Details}">
                  <TextBlock Classes="record-title" Text="{Binding Title}" />
                  <TextBlock Classes="record-detail" Text="{Binding Details}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Button x:Name="StudyRecordsMore" Grid.Column="1" Content="更多记录" Classes="action"
                    IsVisible="False" Click="MoreClicked" />
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="StudyRecordsPreviewPane" Grid.Column="1" Classes="card" Padding="12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBlock x:Name="StudyRecordsPreviewTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="选择一条记录" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="StudyRecordsBack" Grid.Column="1" Content="返回列表" Classes="action"
                    IsVisible="False" VerticalAlignment="Top" Click="BackClicked" />
          </Grid>
          <TextBlock x:Name="StudyRecordsPreviewDetails" Grid.Row="1" Classes="muted" TextWrapping="Wrap"
                     MaxLines="4" TextTrimming="CharacterEllipsis" IsVisible="False"
                     AutomationProperties.LiveSetting="Polite" />
          <Border Grid.Row="2" Classes="record-photo" MinHeight="0" ClipToBounds="True" Margin="0,2,0,0">
            <Grid ClipToBounds="True">
              <Image x:Name="StudyRecordsImage" Stretch="Uniform" AutomationProperties.Name="记录照片" />
              <TextBlock x:Name="StudyRecordsPhotoEmpty" Classes="muted" TextWrapping="Wrap"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                         Text="选择左侧记录查看照片" />
            </Grid>
          </Border>
          <WrapPanel Grid.Row="3" ItemSpacing="6" LineSpacing="5">
            <Button x:Name="StudyRecordsDownload" Content="下载照片" Classes="action" IsVisible="False"
                    Click="DownloadClicked" />
            <Button x:Name="StudyRecordsDelete" Content="删除照片" Classes="action" IsVisible="False"
                    Click="DeleteClicked" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
