<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App"
        x:Class="NPEduConsole.App.ClassCreationWindow" Title="新建行政班" Width="530" Height="660" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.creation-error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBox.batch-cell">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="Border.batch-table">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.batch-row">
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.batch-row.has-issue">
      <Setter Property="Background" Value="{DynamicResource ErrorTintBrush}" />
    </Style>
    <Style Selector="Border.batch-feedback">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.batch-feedback.has-issue">
      <Setter Property="Background" Value="{DynamicResource ErrorTintBrush}" />
    </Style>
    <Style Selector="ListBox.batch-receipt ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
    <Style Selector="Button.batch-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="MinHeight" Value="27" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
  </Window.Styles>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid x:Name="StandardCreationBody" RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,16">
      <StackPanel Spacing="5">
        <TextBlock x:Name="CreationSchool" Classes="muted" />
        <TextBlock Text="新建行政班" FontSize="24" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,14" Spacing="10">
        <Border Classes="card" Padding="16">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="当前学期" Classes="label" />
                <TextBlock x:Name="CreationTerm" Classes="muted" />
              </StackPanel>
              <Button x:Name="ReloadCreationContext" Grid.Column="1" Content="刷新学期与年级" Classes="action" Click="ReloadClicked" />
            </Grid>
            <Button x:Name="OpenGradeCreationButton" Content="新建年级" Classes="action" Click="OpenGradeCreationClicked" IsEnabled="False" />
            <StackPanel x:Name="GradeCreationFields" Spacing="10" IsVisible="False">
              <StackPanel Spacing="4">
                <TextBlock Text="年级名称" Classes="label" />
                <TextBox x:Name="NewGradeName" PlaceholderText="如高一" AutomationProperties.Name="年级名称" TextChanged="GradeFieldsChanged" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="年级代码" Classes="label" />
                <TextBox x:Name="NewGradeCode" PlaceholderText="如 G1" AutomationProperties.Name="年级代码" TextChanged="GradeFieldsChanged" />
                <TextBlock Text="2–64 位，以英文字母或数字开头，可使用 . _ -。" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="SubmitGradeCreationButton" Content="创建年级" Classes="action accent" Click="SubmitGradeClicked" />
                <Button x:Name="BackFromGradeCreationButton" Content="返回建班" Classes="action" Click="BackFromGradeCreationClicked" />
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="CreationFields" Spacing="10" IsEnabled="False">
              <StackPanel Spacing="4">
                <TextBlock Text="所属年级" Classes="label" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <ComboBox x:Name="CreationGrade" PlaceholderText="选择现有年级" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="所属年级" SelectionChanged="FieldsChanged" />
                  <Button x:Name="OpenGradeRenameButton" Grid.Column="1" Content="修改名称" Classes="action"
                          Click="OpenGradeRenameClicked" IsEnabled="False" AutomationProperties.Name="修改年级名称" />
                  <Button x:Name="OpenClassBatchButton" Grid.Column="2" Content="批量开班" Classes="action"
                          Click="OpenClassBatchClicked" IsEnabled="False" AutomationProperties.Name="按年级批量开班" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="班级名称" Classes="label" />
                <TextBox x:Name="CreationName" PlaceholderText="例如：高二（1）班" AutomationProperties.Name="班级名称"
                         TextChanged="FieldsChanged" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="班级代码" Classes="label" />
                <TextBox x:Name="CreationCode" PlaceholderText="例如：G2-C01" AutomationProperties.Name="班级代码"
                         TextChanged="FieldsChanged" LostFocus="NormalizeCode" />
                <TextBlock Text="2–64 位，以英文字母或数字开头，可使用 . _ -，保存时自动转为大写。" Classes="muted" />
              </StackPanel>
              <CheckBox x:Name="CreationStudentSelectable" Content="允许学生自行选择此行政班" IsChecked="True" />
            </StackPanel>
            <StackPanel x:Name="GradeRenameFields" Spacing="10" IsVisible="False">
              <TextBlock x:Name="GradeRenameTarget" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Spacing="4">
                <TextBlock Text="年级名称（仅修改名称）" Classes="label" />
                <TextBox x:Name="RenameGradeName" PlaceholderText="输入新的年级名称" AutomationProperties.Name="新年级名称"
                         TextChanged="GradeRenameFieldsChanged" />
                <TextBlock x:Name="GradeRenameServerName" Classes="muted" TextWrapping="Wrap" IsVisible="False"
                           AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="SubmitGradeRenameButton" Content="保存名称" Classes="action accent"
                        Click="SubmitGradeRenameClicked" />
                <Button x:Name="CheckGradeRenameButton" Content="只读核对" Classes="action" IsVisible="False"
                        Click="CheckGradeRenameClicked" />
                <Button x:Name="CancelGradeRenameButton" Content="返回建班" Classes="action"
                        Click="CancelGradeRenameClicked" />
              </WrapPanel>
              <TextBlock Text="改名期间建班表单临时收起，班级代码、年级代码、学生名单和已填写的班级草稿都会保留；返回建班后继续。" Classes="muted"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock x:Name="CreationFeedback" Classes="muted" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,10">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CloseClassCreationButton" Content="关闭" Classes="action" Click="CloseClicked" />
        <Button x:Name="SubmitClassCreationButton" Content="创建并录入名单" Classes="action accent" Click="SubmitClicked" IsEnabled="False" />
      </StackPanel>
    </Border>
    </Grid>
    <Grid x:Name="BatchFields" IsVisible="False" RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,12">
        <StackPanel Spacing="3">
          <TextBlock Text="按年级批量开班" FontSize="25" FontWeight="SemiBold" />
          <TextBlock x:Name="BatchTarget" Classes="muted" MaxLines="1" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Grid Grid.Row="1" Margin="20,12" RowDefinitions="Auto,*" RowSpacing="8">
        <Border x:Name="BatchFeedbackPanel" Classes="batch-feedback" CornerRadius="8" Padding="10,6"
                IsVisible="False">
          <TextBlock x:Name="BatchFeedback" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Grid x:Name="BatchDraftPane" Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="7">
          <Grid ColumnDefinitions="76,76,*,*" ColumnSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="起始编号" Classes="label" />
              <TextBox x:Name="BatchStartNumber" Classes="batch-cell" AutomationProperties.Name="起始编号" TextChanged="BatchInputChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="结束编号" Classes="label" />
              <TextBox x:Name="BatchEndNumber" Classes="batch-cell" AutomationProperties.Name="结束编号" TextChanged="BatchInputChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="班级名称前缀" Classes="label" />
              <TextBox x:Name="BatchNamePrefix" Classes="batch-cell" AutomationProperties.Name="班级名称前缀" TextChanged="BatchInputChanged" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="4">
              <TextBlock Text="班级代码前缀" Classes="label" />
              <TextBox x:Name="BatchCodePrefix" Classes="batch-cell" AutomationProperties.Name="班级代码前缀" TextChanged="BatchInputChanged" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="BatchSummary" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="输入起止编号和前缀生成预览，一批最多 100 个班。" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="BatchLocateIssueButton" Grid.Column="1" Classes="batch-link" Content="定位首个问题"
                    IsVisible="False" Click="BatchLocateIssueClicked" />
          </Grid>
          <Border Grid.Row="2" Classes="batch-table">
            <Grid RowDefinitions="Auto,*">
              <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                      Padding="11,8,28,8">
                <Grid x:Name="BatchColumnLabels" ColumnDefinitions="40,180,*,105" ColumnSpacing="10">
                  <TextBlock Text="序号" Classes="label" />
                  <TextBlock Grid.Column="1" Text="班级代码" Classes="label" />
                  <TextBlock Grid.Column="2" Text="班级名称" Classes="label" />
                  <TextBlock Grid.Column="3" Text="允许学生自选" Classes="label" />
                </Grid>
              </Border>
              <ScrollViewer x:Name="BatchRowScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible"
                            AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="BatchRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:BatchDraftRow">
                      <Border Classes="batch-row" Classes.has-issue="{Binding HasError}" Padding="11,4">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="40,180,*,105" ColumnSpacing="10">
                          <TextBlock Text="{Binding Position}" Classes="muted" VerticalAlignment="Center" />
                          <TextBox Grid.Column="1" Classes="batch-cell" Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="班级代码" AutomationProperties.AutomationId="{Binding CodeId}" />
                          <TextBox Grid.Column="2" Classes="batch-cell" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="班级名称" AutomationProperties.AutomationId="{Binding NameId}" />
                          <CheckBox Grid.Column="3" MinHeight="0" IsChecked="{Binding IsStudentSelectable, Mode=TwoWay}"
                                    AutomationProperties.Name="允许学生自选" AutomationProperties.AutomationId="{Binding StudentSelectableId}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3,0,2" Text="{Binding Error}"
                                     Classes="creation-error" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock x:Name="BatchEmpty" Grid.Row="1" Text="生成预览后，可在表内逐行编辑代码、名称和学生自选设置。"
                         Classes="muted" Margin="12" IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="BatchResultPane" Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="False">
          <TextBlock x:Name="BatchResultSummary" Classes="muted" TextWrapping="Wrap" />
          <Border Grid.Row="1" Classes="batch-table">
            <Grid RowDefinitions="Auto,*">
              <Border Background="{DynamicResource AccentSoftBrush}" Padding="12,8,28,8">
                <Grid ColumnDefinitions="180,*,105" ColumnSpacing="10">
                  <TextBlock Text="班级代码" Classes="label" />
                  <TextBlock Grid.Column="1" Text="已创建班级" Classes="label" />
                  <TextBlock Grid.Column="2" Text="允许学生自选" Classes="label" />
                </Grid>
              </Border>
              <ListBox x:Name="BatchResults" Grid.Row="1" Background="Transparent" Classes="batch-receipt"
                       SelectionChanged="BatchResultSelectionChanged" AutomationProperties.Name="服务器回执中的班级">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:BatchResultItem">
                    <Grid ColumnDefinitions="180,*,105" ColumnSpacing="10" Margin="5,4">
                      <TextBlock Text="{Binding Class.Code}" Classes="muted" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding Class.Name}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding StudentChoiceText}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border x:Name="BatchWorkspaceActions" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <WrapPanel ItemSpacing="7" LineSpacing="4">
            <Button x:Name="BatchCancelButton" Content="返回建班" Classes="action" Click="BatchCancelClicked" />
            <Button x:Name="BatchCloseButton" Content="关闭" Classes="action" Click="CloseClicked" />
            <Button x:Name="ReloadBatchContextButton" Content="刷新学期" Classes="action" Click="ReloadClicked" IsVisible="False" />
          </WrapPanel>
          <WrapPanel Grid.Column="1" HorizontalAlignment="Right" ItemSpacing="7" LineSpacing="4">
            <Button x:Name="BatchPreviewButton" Content="生成预览" Classes="action" Click="BatchPreviewClicked" />
            <Button x:Name="BatchValidateButton" Content="核对" Classes="action" IsEnabled="False" Click="BatchValidateClicked" />
            <Button x:Name="BatchSubmitButton" Content="保存开班" Classes="action accent" IsEnabled="False" Click="BatchSubmitClicked" />
            <Button x:Name="BatchVerifyReceiptButton" Content="核对结果" Classes="action accent" IsVisible="False" Click="BatchVerifyReceiptClicked" />
            <Button x:Name="BatchOpenSubjectSetupButton" Content="配置授课科目" Classes="action" IsVisible="False" IsEnabled="False"
                    Click="BatchOpenSubjectSetupClicked" />
            <Button x:Name="BatchOpenRosterButton" Content="打开所选班级名单" Classes="action accent" IsVisible="False" IsEnabled="False"
                    Click="BatchOpenRosterClicked" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
