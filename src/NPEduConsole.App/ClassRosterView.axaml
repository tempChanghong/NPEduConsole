<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App" x:Class="NPEduConsole.App.ClassRosterView">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.roster-row">
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.roster-row.compared">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
    <Style Selector="TextBox.roster-cell">
      <Setter Property="MinHeight" Value="33" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="ListBox.roster-compare ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TextBlock.roster-change.added">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.roster-change.removed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.roster-row-action">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBlock.roster-error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="5">
          <TextBlock Text="学生名单" FontSize="25" FontWeight="SemiBold" />
          <TextBlock x:Name="RosterScope" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="ReloadRosterButton" Grid.Column="1" Content="重新载入" Classes="action" Click="ReloadClicked" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="RosterContentHost" Grid.Row="1" Margin="20,12" RowDefinitions="Auto,*" RowSpacing="8">
      <TextBlock x:Name="RosterFeedback" Classes="muted" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Polite" />

      <Grid x:Name="RosterEditorPane" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
        <Border Classes="card" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="11,8">
              <TextBlock x:Name="RosterCount" FontSize="17" Classes="label" VerticalAlignment="Center" />
              <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="4">
                <Button x:Name="RosterCorrectArchived" Content="更正名单" Classes="action accent" Click="EnableCorrectionClicked" IsVisible="False"/>
                <Button x:Name="OpenRosterImport" Content="从 Excel 粘贴" Classes="action" Click="ToggleImportClicked"/>
                <Button x:Name="AddRosterStudent" Content="添加学生" Classes="action" Click="AddClicked" />
              </WrapPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="10,7,28,7">
              <Grid x:Name="RosterTableHeader" ColumnDefinitions="36,1.15*,*" ColumnSpacing="7">
                <TextBlock Text="序号" Classes="label" />
                <TextBlock Grid.Column="1" Text="姓名" Classes="label" />
                <TextBlock Grid.Column="2" Text="学号（可空）" Classes="label" />
              </Grid>
            </Border>
            <Grid Grid.Row="2">
              <ScrollViewer x:Name="RosterList" VerticalScrollBarVisibility="Visible" AllowAutoHide="False"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RosterRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RosterDraftRow">
                      <Border Classes="roster-row" Classes.compared="{Binding IsCompared}" Padding="10,4" GotFocus="SelectStudentRow">
                        <Grid ColumnDefinitions="36,1.15*,*" ColumnSpacing="7">
                          <TextBlock Text="{Binding Position}" Classes="muted" VerticalAlignment="Center" />
                          <TextBox Grid.Column="1" Classes="roster-cell" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="学生姓名" AutomationProperties.AutomationId="{Binding NameEditorId}" />
                          <TextBox Grid.Column="2" Classes="roster-cell" Text="{Binding StudentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="学生学号" AutomationProperties.AutomationId="{Binding NumberEditorId}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock x:Name="EmptyRosterDraft" Classes="muted" Text="暂无学生。可添加单行，或从 Excel 批量粘贴。"
                         IsHitTestVisible="False" Margin="2,10,2,0" IsVisible="False" />
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,6" x:Name="RosterSelectedActions">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="SelectedRosterStudent" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                  <Button x:Name="MoveRosterStudentUp" Content="上移" Classes="action roster-row-action" Click="MoveUpClicked"/>
                  <Button x:Name="MoveRosterStudentDown" Content="下移" Classes="action roster-row-action" Click="MoveDownClicked"/>
                  <Button x:Name="RemoveRosterStudent" Content="移出名单" Classes="action roster-row-action" Click="RemoveClicked"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="RosterImportPanel" Grid.Column="1" Classes="card" Padding="13" Width="236" IsVisible="False">
          <Grid>
            <Grid x:Name="RosterImportPane" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Text="批量粘贴" FontSize="17" Classes="label" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="收起" Click="ToggleImportClicked" Classes="action roster-row-action"/>
              </Grid>
              <TextBlock Grid.Row="1" Classes="muted" Text="复制学号、姓名两列，省略表头。也可每行粘贴一个姓名。" />
              <ComboBox x:Name="RosterImportMode" Grid.Row="2" HorizontalAlignment="Stretch" AutomationProperties.Name="批量导入方式"
                        SelectionChanged="ImportModeChanged">
                <ComboBoxItem Content="追加或更新" />
                <ComboBoxItem Content="整班替换" />
              </ComboBox>
              <TextBox x:Name="RosterPasteText" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="53"
                       PlaceholderText="在此粘贴名单" TextChanged="DraftTextChanged" AutomationProperties.Name="批量粘贴名单" />
              <StackPanel Grid.Row="4" Spacing="7">
                <TextBlock x:Name="RosterImportHint" Classes="muted" />
                <Button x:Name="ApplyRosterImport" Classes="action" Content="应用到草稿" Click="ApplyImportClicked" />
              </StackPanel>
            </Grid>

          </Grid>
        </Border>
      </Grid>

      <Border x:Name="RosterComparisonPane" Grid.Row="1" Classes="card" ClipToBounds="True" IsVisible="False">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Margin="12,9" Spacing="3">
            <TextBlock Text="核对名单差异" FontSize="17" Classes="label"/>
            <TextBlock x:Name="RosterComparisonHint" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="0,0,0,1" Padding="12,7,28,7">
            <Grid ColumnDefinitions="105,*,*" ColumnSpacing="12">
              <TextBlock Text="差异" Classes="label"/>
              <TextBlock Grid.Column="1" Text="服务器当前" Classes="label"/>
              <TextBlock Grid.Column="2" Text="我的草稿" Classes="label"/>
            </Grid>
          </Border>
          <ListBox x:Name="CurrentRosterRows" Grid.Row="2" Classes="roster-compare" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CurrentSelectionChanged"
                   AutomationProperties.Name="按学生核对服务器名单与草稿">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:RosterComparisonRow">
                <Border Classes="roster-row" Padding="12,7" AutomationProperties.AutomationId="{Binding AutomationId}">
                  <Grid ColumnDefinitions="105,*,*" ColumnSpacing="12">
                    <TextBlock Text="{Binding Kind}" Classes="label" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding ServerLabel}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="2" Text="{Binding DraftLabel}" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="3" Margin="10,6" ItemSpacing="6" LineSpacing="5">
            <Button x:Name="RecheckRosterButton" Classes="action" Content="重新核对" Click="RecheckClicked"/>
            <Button x:Name="UseCurrentStudentButton" Classes="action" Content="此行采用服务器内容" Click="UseCurrentStudentClicked"/>
            <Button x:Name="AdoptRosterRevisionButton" Classes="action accent" Content="以服务器当前名单为基准重新预览" Click="AdoptRevisionClicked"/>
          </WrapPanel>
        </Grid>
      </Border>

      <Border x:Name="RosterReviewPane" Grid.Row="1" Classes="card" ClipToBounds="True" IsVisible="False">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Spacing="4" Margin="12,9">
            <TextBlock Text="核对本次变更" Classes="label" FontSize="17" />
            <TextBlock x:Name="RosterReviewSummary" Classes="muted" />
          </StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="0,0,0,1" Padding="12,8,28,8">
            <Grid x:Name="RosterPreviewTableHeader" ColumnDefinitions="102,*,*" ColumnSpacing="12">
              <TextBlock Text="变更" Classes="label" />
              <TextBlock Grid.Column="1" Text="原名单" Classes="label" />
              <TextBlock Grid.Column="2" Text="保存后" Classes="label" />
            </Grid>
          </Border>
          <ListBox x:Name="RosterChangesList" Grid.Row="2" Classes="roster-compare" Background="Transparent"
                   AutomationProperties.Name="待保存的名单变更" ScrollViewer.AllowAutoHide="False"
                   ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:RosterReviewRow">
                <Border Classes="roster-row" Padding="12,6" AutomationProperties.AutomationId="{Binding AutomationId}">
                  <Grid ColumnDefinitions="102,*,*" ColumnSpacing="12">
                    <TextBlock Text="{Binding Kind}" Classes="label roster-change"
                               Classes.added="{Binding IsAdd}" Classes.removed="{Binding IsRemove}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding After}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

      </Border>
    </Grid>

    <Border x:Name="RosterWorkspaceActions" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,10">
      <Grid>
        <Grid x:Name="RosterMainActions" ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock x:Name="RosterDraftState" VerticalAlignment="Center" Classes="muted" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CopyRosterDraftButton" Content="复制草稿" Classes="action" Click="CopyDraftClicked" />
            <Button x:Name="CancelRosterReview" Content="返回编辑" Classes="action" Click="CancelReviewClicked" IsVisible="False" />
            <Button x:Name="CloseRosterButton" Content="返回班级" Classes="action" Click="CloseClicked" />
            <Button x:Name="PreviewRosterButton" Content="预览变更" Classes="action accent" Click="PreviewClicked" />
            <Button x:Name="ConfirmRosterSave" Content="确认保存名单" Classes="action accent" Click="SaveClicked" IsVisible="False" />
          </StackPanel>
        </Grid>
        <Grid x:Name="RosterDiscardActions" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="False">
          <TextBlock x:Name="RosterDiscardWarning" VerticalAlignment="Center" Classes="label" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="KeepRosterEditing" Content="保留草稿" Classes="action" Click="KeepEditingClicked" />
            <Button x:Name="ConfirmRosterDiscard" Content="放弃草稿" Classes="action" Click="DiscardClicked" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
