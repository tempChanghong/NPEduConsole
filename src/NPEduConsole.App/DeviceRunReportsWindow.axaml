<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NPEduConsole.App" x:Class="NPEduConsole.App.DeviceRunReportsWindow"
        Title="教室设备运行报告" Width="1040" Height="690" MinWidth="660" MinHeight="440" WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource CanvasBrush}" Padding="16,12">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="9">
      <StackPanel Spacing="4">
        <TextBlock Text="运行报告" Classes="label" FontSize="23" />
        <TextBlock x:Name="RunReportTarget" Classes="label" TextWrapping="Wrap" />
        <TextBlock x:Name="RunReportLive" Classes="muted" TextWrapping="Wrap" />
        <TextBlock x:Name="RunReportFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <Grid x:Name="RunReportColumns" Grid.Row="1" ColumnDefinitions="1*,1.45*" ColumnSpacing="10">
        <Border x:Name="RunReportListPane" Classes="card" Padding="10">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="已结束的报告" Classes="label" VerticalAlignment="Center" />
              <ComboBox x:Name="RunReportFilter" SelectedIndex="0" AutomationProperties.Name="筛选报告来源">
                <ComboBoxItem Content="全部来源" />
                <ComboBoxItem Content="学校排程" />
                <ComboBoxItem Content="手动自习" />
                <ComboBoxItem Content="来源待核对" />
              </ComboBox>
            </StackPanel>
            <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" Text="设备接口显示最近 20 份结束报告。服务端每台最多保留 30 天内的 200 份。" />
            <ListBox x:Name="RunReportRows" Grid.Row="2" Classes="object-list" Background="Transparent" AutomationProperties.Name="运行报告列表"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:DeviceRunReportRow">
                  <StackPanel Spacing="3" Margin="3,5">
                    <TextBlock Text="{Binding Title}" Classes="label" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="RunReportOpen" Grid.Row="3" Classes="action accent" Content="查看报告" Click="OpenReport" />
          </Grid>
        </Border>
        <Border x:Name="RunReportDetailPane" Grid.Column="1" Classes="card" Padding="10">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <TextBlock x:Name="RunReportDetailStatus" IsVisible="False" Classes="muted" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <local:DeviceRunReportDetail x:Name="RunReportDetail" />
            </ScrollViewer>
            <Button x:Name="RunReportRecords" Grid.Row="2" Classes="action" Content="本场照片与退出记录" Click="OpenRecords" IsVisible="False" />
          </Grid>
        </Border>
      </Grid>
      <WrapPanel Grid.Row="2" HorizontalAlignment="Right" ItemSpacing="6" LineSpacing="4">
        <Button x:Name="RunReportBack" Classes="action" Content="返回" Click="GoBack" />
        <Button x:Name="RunReportField" Classes="action" Content="现场处置" Click="OpenField" />
        <Button x:Name="RunReportRefresh" Classes="action" Content="刷新报告" Click="Refresh" />
      </WrapPanel>
    </Grid>
  </Border>
</Window>
