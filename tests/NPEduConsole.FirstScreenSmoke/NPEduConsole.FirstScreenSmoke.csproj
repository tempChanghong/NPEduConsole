    <ProjectReference Include="../../src/NPEduConsole.Core/NPEduConsole.Core.csproj" />
    <ProjectReference Include="$(NPEduToolsCheckout)/src/NPEduTools.Integrations.Npep/NPEduTools.Integrations.Npep.csproj" />
  </ItemGroup>
</Project>
